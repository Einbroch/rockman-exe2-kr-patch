      "estimated_growth_bytes": -21,
      "page_count": 6,
      "line_count": 17,
      "lines": [
        {
          "text": "개인용",
          "glyph_count": 3,
          "estimated_stream_bytes": 3
        },
        {
          "text": "「휴대 정보 단말기」,",
          "glyph_count": 12,
          "estimated_stream_bytes": 13
        },
        {
          "text": "그게 바로 「PET」입니다.",
          "glyph_count": 15,
          "estimated_stream_bytes": 15
        },
        {
          "text": "「PErsonal Terminal」을",
          "glyph_count": 20,
          "estimated_stream_bytes": 20
        },
        {
          "text": "줄여서 「PET」이라 부릅니다.",
          "glyph_count": 17,
          "estimated_stream_bytes": 17
        },
        {
          "text": "「PET」은 「휴대전화」가",
          "glyph_count": 14,
          "estimated_stream_bytes": 16
        },
        {
          "text": "발전해 더 다양한 기능이",
          "glyph_count": 13,
          "estimated_stream_bytes": 15
        },
        {
          "text": "추가된 기기입니다.",
          "glyph_count": 10,
          "estimated_stream_bytes": 11
        },
        {
          "text": "E메일은 물론,",
          "glyph_count": 8,
          "estimated_stream_bytes": 8
        },
        {
          "text": "전자화폐로 물건도 사고,",
          "glyph_count": 13,
          "estimated_stream_bytes": 15
        },
        {
          "text": "교과서 데이터도 들어 있습니다.",
          "glyph_count": 17,
          "estimated_stream_bytes": 18
        },
        {
          "text": "하지만 복잡한 조작은 필요 없습니다.",
          "glyph_count": 20,
          "estimated_stream_bytes": 24
        },
        {
          "text": "안에 있는 내비게이션 프로그램에게",
          "glyph_count": 18,
          "estimated_stream_bytes": 19
        },
        {
          "text": "말하면 뭐든 해 줍니다.",
          "glyph_count": 13,
          "estimated_stream_bytes": 15
        },
        {
          "text": "예를 들어, 5학년 A반 히카리 넷토의",
          "glyph_count": 21,
          "estimated_stream_bytes": 25
        },
        {
          "text": "PET에는 「록맨」이라는 내비가",
          "glyph_count": 17,
          "estimated_stream_bytes": 17
        },
        {
          "text": "들어 있습니다.",
          "glyph_count": 8,
          "estimated_stream_bytes": 8
        }
      ],
      "status": "planned_not_reinserted"
    },
    {
