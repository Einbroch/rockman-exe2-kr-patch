@size 11

script 0 mmbn2 {
	mugshotShow
		mugshot = MsMari
	msgOpen
	"""
	つぎは、今日さいごの かだい
	「フォルダオープン」に ついてです
	もうひといきだから がんばってね!
	"""
	keyWait
	clearMsg
	"""
	「フォルダオープン」 ていうのは、
	カスタムウインドウに出る チップを
	5つから ふやす テクニックよ
	"""
	keyWait
	clearMsg
	"""
	えらべる チップデータが ふえれば、
	いろんな くみ合わせが できやすくなって
	ゆうりに なるわ
	"""
	keyWait
	clearMsg
	"""
	じゃあ がめんに ちゅうもく、
	カスタムウインドウの 右下に
	「ADD」という ボタンが あるでしょ?
	"""
	keyWait
	end
}
script 1 mmbn2 {
	mugshotShow
		mugshot = MsMari
	msgOpen
	"""
	ほしいチップが 出てなかったり、
	くみ合わせたいチップが あと1枚たりない
	ってこと よくあるんだけど、
	"""
	keyWait
	clearMsg
	"""
	そんな時には、
	いらないチップを えらんでから
	この 「ADD」ボタンを おすの
	"""
	keyWait
	clearMsg
	"""
	えらんだチップデータは すてられちゃって
	そのターンは チップなしで
	たたかわないと いけないんだけど・・・
	"""
	keyWait
	clearMsg
	"""
	そのかわりに、つぎの ターンからは
	えらべるチップが すてた枚数分 だけ
	ふえた じょうたいに なるの!!
	"""
	keyWait
	clearMsg
	"""
	チップを くみ合わせやすく なるから
	まさに イッパツぎゃくてんの
	チャンスよ!
	"""
	keyWait
	clearMsg
	"""
	それじゃ、れんしゅう してみましょう
	今 「リカバリー10」が 3枚も
	出てるのが ちょっと ジャマよね
	"""
	keyWait
	end
}
