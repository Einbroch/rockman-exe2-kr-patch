script 6 mmbn2 {
	mugshotShow
		mugshot = GaussMagnus
	msgOpen
	"""
	いいだろう・・・
	おしえてやろうじゃないか
	"""
	keyWait
	clearMsg
	"""
	ワタシは、おさないころ
	とても まずしいかていに
	そだった・・・
	"""
	keyWait
	clearMsg
	"""
	すきまかぜのふきこむ あばらやにすみ
	まいにち、くうやくわずの せいかつ
	"""
	keyWait
	clearMsg
	"""
	ただひとりいた おとうとの ジャックは
	ゆうふくな かていにひきとられ
	"""
	keyWait
	clearMsg
	"""
	そのご、りょうしんを
	びょうきでなくした・・・
	"""
	keyWait
	clearMsg
	"ワタシは ひとりになった・・・"
	keyWait
	clearMsg
	"""
	しかし、しゃかいは ワタシを
	たすけてはくれなかった
	"""
	keyWait
	clearMsg
	"ヒトが にくかった・・・"
	keyWait
	clearMsg
	"しゃかいが にくかった!"
	keyWait
	clearMsg
	"""
	いつか、ワタシを たすけてくれなかった
	しゃかいを みかえしてやろうと
	しぬきではたらいた
	"""
	keyWait
	clearMsg
	"""
	そして、げんざいの
	ちい をてにいれた
	"""
	keyWait
	clearMsg
	"""
	ヒトのうえに たち、
	しゃかいを うごかす
	けんりょくも てにいれた
	"""
	keyWait
	clearMsg
	"""
	しかし、ワタシがもとめていたものは
	そんなものではなかったのだよ・・・
	"""
	keyWait
	clearMsg
	"ワタシがもとめるものは・・・"
	keyWait
	clearMsg
	"あらたなる ちつじょ"
	keyWait
	clearMsg
	"""
	いまのしゃかいは
	くさりきっているのだよ
	"""
	keyWait
	clearMsg
	"""
	くさってしまったしゃかいを
	たてなおすためには
	"""
	keyWait
	clearMsg
	"""
	いちど、すべてを
	こわさないといけないのだ
	"""
	keyWait
	clearMsg
	"""
	そう、おもっているところに
	ゴスペルから、こえが かかったのだよ
	"""
	keyWait
	clearMsg
	"ワタシは、すぐにかんぶにのぼりつめ"
	keyWait
	clearMsg
	"""
	「きゅうきょくのナビ」
	かいはつプロジェクトの
	リーダーになった・・・
	"""
	keyWait
	clearMsg
	"""
	「きゅうきょくのナビ」が
	かんせいしたときは、
	"""
	keyWait
	clearMsg
	"""
	ネットワークしゃかいが、
	かいめつするときだ
	"""
	keyWait
	clearMsg
	"""
	それは、ワタシのしゃかいにたいする
	ほうふくの ときでもあるのだ
	"""
	keyWait
	clearMsg
	"""
	なんじゅうねん
	ワタシは、このひがくるのを
	まっていただろうか・・・
	"""
	keyWait
	clearMsg
	"""
	そして、ワタシのほうふくが
	かんりょうしたとき
	"""
	keyWait
	clearMsg
	"""
	せかいに こんとんがおとずれ
	ゴスペルが あらたなる ちつじょを
	つくりあげるのだ!!
	"""
	keyWait
	clearMsg
	jump
		target = 7
}
