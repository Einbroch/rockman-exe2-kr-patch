script 0 mmbn2 {
	mugshotShow
		mugshot = MsMari
	msgOpen
	"""
	じゃこんどは、サポートこうかのある
	チップデータについて
	せつめいしていくわよ
	"""
	keyWait
	clearMsg
	"""
	チップデータの中には、
	ぶきのデータいがいのものもあります
	"""
	keyWait
	clearMsg
	"""
	たとえば、これはエリアスチールと言って
	ナビがうごけるエリアを
	広くするチップデータです
	"""
	keyWait
	end
}
