script 3 mmbn2 {
	mugshotShow
		mugshot = MsMari
	msgOpen
	"""
	アルファベットがあるでしょ?
	これはチップコードといいます
	トランプのマークみたいなものね
	"""
	keyWait
	clearMsg
	"""
	チップコードが同じチップデータは、
	ちがうしゅるいでもいっしょに
	えらぶことができるの
	"""
	keyWait
	clearMsg
	"""
	あとで見てほしいんだけど、今だと
	エリアスチールとワイドソードの
	チップコードがどっちもLだから、
	"""
	keyWait
	clearMsg
	"""
	2つのチップを、
	いっしょにえらぶことができるわ
	"""
	keyWait
	clearMsg
	"""
	ちなみに*っていうコードもあるんだけど
	これはアスタリスクっていって、
	トランプのジョーカーみたいなものね
	"""
	keyWait
	clearMsg
	"""
	どのコードとでも いっしょにえらべる
	べんりなコードなの
	おぼえておいてね
	"""
	keyWait
	clearMsg
	"""
	じゃ今回は、コードLでつないでみます
	エリアスチールと、ワイドソードを
	れんぞくでつかってみましょう
	"""
	keyWait
	end
}
