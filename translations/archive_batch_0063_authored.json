    {
      "selector": "00/364",
      "entry_index": 3,
      "draft_translation": "[textSpeed delay=1]플러그인!![wait 10] // 록맨.EXE,[wait 10] // 트랜스미션![wait 30]"
    },
    {
      "selector": "00/364",
      "entry_index": 5,
      "draft_translation": "이런 곳에 / PET가 떨어져 있다니 수상해! // 플러그인해서 안을 조사해 볼까? // 예 // 아니요"
    },
    {
      "selector": "00/364",
      "entry_index": 6,
      "draft_translation": "이건 물통 모양의 / 기폭 장치인 것 같아! // 플러그인해서 안을 조사해 볼까? // 예 // 아니요"
    },
    {
      "selector": "00/364",
      "entry_index": 7,
      "draft_translation": "이런 곳에 PET가 떨어져 있어! / 아까까지만 해도 없었는데... // 플러그인해서 안을 조사해 볼까? // 예 // 아니요"
    },
    {
      "selector": "00/364",
      "entry_index": 9,
      "draft_translation": "넷토, / 지금은 시험 중이 아니라서 / 플러그인할 수 없어."
    },
    {
      "selector": "00/364",
      "entry_index": 10,
      "draft_translation": "빨리 메인 시스템을 / 조사하고 와!"
    },
    {
      "selector": "00/365",
      "entry_index": 0,
      "draft_translation": "록맨, 플러그아웃할까? // 예 // 아니요"
    },
    {
      "selector": "00/365",
      "entry_index": 1,
      "draft_translation": "OK! 알겠어!"
    },
    {
      "selector": "00/365",
      "entry_index": 5,
      "draft_translation": "넷토, 뭔가 엄청난 힘이 / 작용하고 있어서 플러그아웃할 / 수가 없어!"
    },
    {
      "selector": "00/365",
      "entry_index": 6,
      "draft_translation": "넷토, 마음은 알겠지만 / 지금 플러그아웃하는 건 위험해! / 폭탄이 터지고 말 거야!!"
    },
    {
      "selector": "00/365",
      "entry_index": 7,
      "draft_translation": "서두르지 않으면 궁극의 내비가 / 활동을 시작하고 말 거야! / 플러그아웃할 틈이 없어!!"
    },
    {
      "selector": "00/366",
      "entry_index": 0,
      "draft_translation": "L 버튼을 누르면 / 넷토와 록맨이 대화할 수 있다! / (여기는 아직 안 들어갔습니다)"
    },
    {
      "selector": "00/366",
      "entry_index": 5,
      "draft_translation": "왜 그래, 넷토? // 있지? 모두와 이야기해 보자.[waitSkip 15] // 휴일 이야기로 들뜬 / 모양이잖아!"
    },
    {
      "selector": "00/366",
      "entry_index": 6,
      "draft_translation": "아까 누가 「할 말이 있다」고 / 하지 않았어?"
    },
    {
      "selector": "00/366",
      "entry_index": 7,
      "draft_translation": "어떻게 할래? 슬슬 집에 갈까?"
    },
    {
      "selector": "00/366",
      "entry_index": 8,
      "draft_translation": "여기가 넷토가 사는 아키하라 마을이네.[waitSkip 30] // 응? 알고 있다고?"
    },
    {
      "selector": "00/366",
      "entry_index": 9,
      "draft_translation": "엄마가 있네. / 간식이라도 만들어 주시려나?"
    },
    {
      "selector": "00/366",
      "entry_index": 10,
      "draft_translation": "넷토, 숙제부터 끝내자! / R 버튼으로 나를 / 컴퓨터 안에 보내 줘."
    },
    {
      "selector": "00/366",
      "entry_index": 15,
      "draft_translation": "넷토, / 오피셜 스퀘어에 갈 거면 / 인터넷에서 가야지?"
    },
    {
      "selector": "00/366",
