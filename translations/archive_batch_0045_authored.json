{
  "schema_version": 1,
  "batch_number": 45,
  "entries": [
    {"selector":"00/278","entry_index":0,"draft_translation":"아까 승객들 짐을 / 정리하고 있었는데, 커다란 거미가 / 사사삭 달려가는 거 있지."},
    {"selector":"00/278","entry_index":1,"draft_translation":"어떤 거미였어?"},
    {"selector":"00/278","entry_index":2,"draft_translation":"검은 털이 북슬북슬하고 / 다리가 아주 굵었어. / 맞아, 눈이 유난히 빨갰어. // 그래도 뭐, 괜찮겠지?"},
    {"selector":"00/278","entry_index":3,"draft_translation":"괜찮지 않을까?"},
    {"selector":"00/278","entry_index":4,"draft_translation":"넷토 군, 방금 대화 들었어?"},
    {"selector":"00/278","entry_index":5,"draft_translation":"검은 털이 북슬북슬하고 / 다리가 굵은 거미라... // 혹시 / 독거미 아닐까?"},
    {"selector":"00/278","entry_index":6,"draft_translation":"그렇다면 큰일이야. // 곤충을 잘 아는 사람에게 / 확인하는 게 좋지 않을까?"},

    {"selector":"00/279","entry_index":0,"draft_translation":"무슨 일이니, 꼬마야?"},
    {"selector":"00/279","entry_index":1,"draft_translation":"저기, 아저씨는 곤충을 잘 알아요?"},
    {"selector":"00/279","entry_index":2,"draft_translation":"잘 아느냐고? / 그냥 잘 아는 정도가 아니란다. // 아저씨는 곤충에 관해서라면 / 걸어 다니는 곤충 백과라고 / 불릴 정도지."},
    {"selector":"00/279","entry_index":3,"draft_translation":"그럼 하나 물어볼게요. // 검은 털이 북슬북슬하고 / 다리가 굵은 거미를 아세요?"},
    {"selector":"00/279","entry_index":4,"draft_translation":"흐음... 짐작 가는 거미가 / 아주 많구나... // 다른 특징은 없니?"},
    {"selector":"00/279","entry_index":5,"draft_translation":"으음, 분명... / 눈이 유난히 빨갔다고 했어요."},
    {"selector":"00/279","entry_index":6,"draft_translation":"오오, 그렇다면 간단하지. / 그 거미는 아메롭파 일부 지역에만 / 서식하는 // 붉은눈털북숭이독거미란다."},
    {"selector":"00/279","entry_index":7,"draft_translation":"붉은눈털북숭이독거미!?"},
    {"selector":"00/279","entry_index":8,"draft_translation":"그래, 그 거미는 / 아주 희귀한 거미란다... // 북슬북슬한 털과 / 번뜩이는 붉은 눈이 / 특징이지. // 게다가 강력한 독을 지녔어. // 사람이 물리면 몇 시간 동안 / 몸이 마비되어 움직일 수 없게 돼..."},
    {"selector":"00/279","entry_index":9,"draft_translation":"으아아아악!!"},
    {"selector":"00/279","entry_index":10,"draft_translation":"뭐지!?"},
    {"selector":"00/279","entry_index":11,"draft_translation":"이코노미석 쪽에서 들렸어! // 넷토 군, 설마!?"},
    {"selector":"00/279","entry_index":12,"draft_translation":"록맨, 가자!"},
    {"selector":"00/279","entry_index":13,"draft_translation":"응!"},
    {"selector":"00/279","entry_index":14,"draft_translation":"아저씨, 고마워요!"},

    {"selector":"00/280","entry_index":0,"draft_translation":"무슨 일이에요!?"},
    {"selector":"00/280","entry_index":1,"draft_translation":"거, 거미에게... 당... 했... / ...털썩."},
    {"selector":"00/280","entry_index":2,"draft_translation":"어, 어떡하지... / 나, 나, 나는..."},
    {"selector":"00/280","entry_index":3,"draft_translation":"록맨, 이 비행기에 / 의사 선생님이 타고 있는지 / 찾아보자!"},

    {"selector":"00/281","entry_index":0,"draft_translation":"의사 선생님을 모셔 왔어!"},
    {"selector":"00/281","entry_index":1,"draft_translation":"후우, 이걸로 됐어."},
    {"selector":"00/281","entry_index":2,"draft_translation":"이제 괜찮은 건가요...?"},
    {"selector":"00/281","entry_index":3,"draft_translation":"응급처치는 했지만 / 일본에 도착할 때까지 절대 안정이야. // 상태를 보니 어떤 독 때문에 / 쇼크에 빠진 것 같은데..."},
    {"selector":"00/281","entry_index":4,"draft_translation":"이분, 아까 거미에게 물렸대요..."},
    {"selector":"00/281","entry_index":5,"draft_translation":"독거미가 기내에 있다고요? / 왜 승객들에게 알리지 않았습니까!?"},
    {"selector":"00/281","entry_index":6,"draft_translation":"죄송해요! / 독이 있는 줄은 / 몰랐고..."},
    {"selector":"00/281","entry_index":7,"draft_translation":"...... / 지금 승무원에게 따져 봐야 / 소용없겠지. // 아무튼 한시라도 빨리 / 독거미를 붙잡아야 해! // 하지만 나는 환자를 / 돌봐야 하고..."},
    {"selector":"00/281","entry_index":8,"draft_translation":"제가 붙잡아 올게요!"},
    {"selector":"00/281","entry_index":9,"draft_translation":"네가... 말이니?"},
    {"selector":"00/281","entry_index":10,"draft_translation":"괜찮다니까요! / 맡겨 주세요! / 곤충을 잘 아는 사람도 알고 있어요."},
    {"selector":"00/281","entry_index":11,"draft_translation":"알았다, 네게 맡기마! / 그리고 다른 승객들이 / 눈치채지 않게 해다오. // 기내에 독거미가 있다는 걸 알면 / 공황 상태에 빠질 거야. // 그러면 부상자가 / 몇 명이나 생길지 몰라. / 그러니 신중하게 움직여! // 나는 안쪽 방에서 / 환자를 돌보고 있을 테니, // 잘 부탁한다!"},

    {"selector":"00/282","entry_index":0,"draft_translation":"아저씨, 사실대로 말할게요."},
    {"selector":"00/282","entry_index":1,"draft_translation":"무슨 일이니? 사실이라니."},
    {"selector":"00/282","entry_index":2,"draft_translation":"이러쿵저러쿵..."},
    {"selector":"00/282","entry_index":3,"draft_translation":"뭐라고―!? / 붉은눈털북숭이독거미가?"},
    {"selector":"00/282","entry_index":4,"draft_translation":"아저씨, 쉿―――! / 목소리가 너무 커요!!"},
    {"selector":"00/282","entry_index":5,"draft_translation":"앗, 미안하다. // 그래서 거미를 붙잡아야 하는 거지? / 그럼 덫을 놓자! // 너는 덫을 만들 / 재료를 모아다 주렴."},
    {"selector":"00/282","entry_index":6,"draft_translation":"어떤 덫을 놓을 건데요?"},
    {"selector":"00/282","entry_index":7,"draft_translation":"그건 보면 알게 될 거란다. // 아무튼 필요한 물건은, // 바구니 같은 물건 / 막대기 하나 / 끈 // 그리고 위스키다."},
    {"selector":"00/282","entry_index":8,"draft_translation":"위스키? 왜요?"},
    {"selector":"00/282","entry_index":9,"draft_translation":"붉은눈털북숭이독거미는 사실 / 고급 위스키 냄새를 좋아한단다. // 고급 위스키의 향이 / 거미가 번식기에 내뿜는 / 페로몬 냄새와 비슷하거든..."},
    {"selector":"00/282","entry_index":10,"draft_translation":"아, 알았어요! / 아, 아무튼 // 바구니, 받침 막대기, 끈, / 고급 위스키를 / 찾아올게요."},

    {"selector":"00/283","entry_index":0,"draft_translation":"아저씨, 덫 재료를 / 전부 모았어요!!"},
    {"selector":"00/283","entry_index":1,"draft_translation":"드디어 다 모았구나. / 그럼 덫을 놓으러 가자. // 그런데 거미가 지금 / 어디쯤 있으려나..."},
    {"selector":"00/283","entry_index":2,"draft_translation":"꺅!"},
    {"selector":"00/283","entry_index":3,"draft_translation":"!?"},
    {"selector":"00/283","entry_index":4,"draft_translation":"방금 뭔가 검은 것이 / 퍼스트 클래스 쪽으로 / 달려갔어요..."},

    {"selector":"00/284","entry_index":0,"draft_translation":"퍼스트 클래스 승객 여러분! / 이 객실에 위험한 독거미가 있습니다! // 지금부터 붙잡을 테니 / 제 지시대로 움직여 주십시오!"},
    {"selector":"00/284","entry_index":1,"draft_translation":"뭐라고?"},
    {"selector":"00/284","entry_index":2,"draft_translation":"그게 정말인가? / 오, 신이시여~"},
    {"selector":"00/284","entry_index":3,"draft_translation":"좋아, 이제 녀석이 / 오기만 기다리면 돼."},
    {"selector":"00/284","entry_index":4,"draft_translation":"왔다!!"},
    {"selector":"00/284","entry_index":5,"draft_translation":"지금이야!!"},
    {"selector":"00/284","entry_index":6,"draft_translation":"해냈다!!"},
    {"selector":"00/284","entry_index":7,"draft_translation":"포획 성공!! / 여러분, 소란을 피워 죄송합니다! // 협조해 주셔서 감사합니다!!"},
    {"selector":"00/284","entry_index":8,"draft_translation":"아저씨, 고마워요!!"},
    {"selector":"00/284","entry_index":9,"draft_translation":"뭐, 이 정도야 식은 죽 먹기지."},
    {"selector":"00/284","entry_index":10,"draft_translation":"자, 거미도 무사히 붙잡았으니 / 자리로 돌아갈까!"},

    {"selector":"00/285","entry_index":0,"draft_translation":"붉은눈털북숭이독거미를 / 붙잡고 몇 시간 뒤..."},
    {"selector":"00/285","entry_index":1,"draft_translation":"안내 말씀 드립니다. // 시각은 오전 5시 정각입니다. / 현재 순조롭게 비행을..."},
    {"selector":"00/285","entry_index":2,"draft_translation":"수, 순조롭게..."},
    {"selector":"00/285","entry_index":3,"draft_translation":"수, 수..."},
    {"selector":"00/285","entry_index":4,"draft_translation":"꺄악!! // 여러분! / 안전벨트를 매 주십시오!"},
    {"selector":"00/285","entry_index":5,"draft_translation":"뭐야, 무슨 일이야?"},
    {"selector":"00/285","entry_index":6,"draft_translation":"넷토 군! / 비행기가 흔들리고 있어!"},

    {"selector":"00/286","entry_index":0,"draft_translation":"기장님!! // 우측 엔진에 이상 발생!! / 버그인 것 같습니다! // 이쪽에서 보내는 입력을 / 전혀 받아들이지 않습니다!!"},
    {"selector":"00/286","entry_index":1,"draft_translation":"기내 넷배틀러를 불러!"},
    {"selector":"00/286","entry_index":2,"draft_translation":"그게, 독거미 소동 때 / 거미에게 물린 사람이 / 넷배틀러였다고 합니다..."},

    {"selector":"00/287","entry_index":0,"draft_translation":"승객 중에 / 넷배틀러가 계십니까? // 계시다면 즉시 조종실로 / 와 주십시오."},
    {"selector":"00/287","entry_index":1,"draft_translation":"들었어, 넷토 군!?"},
    {"selector":"00/287","entry_index":2,"draft_translation":"무슨 일이 생긴 모양이야!"},
    {"selector":"00/287","entry_index":3,"draft_translation":"가자! 조종실로!"},

    {"selector":"00/288","entry_index":0,"draft_translation":"기장님! / 저, 시민 넷배틀러예요!"},
    {"selector":"00/288","entry_index":1,"draft_translation":"오오, 네가 그 아이구나. // 지금 우측 엔진 프로그램에 / 버그가 발생했다. // 그 때문에 좌우 엔진의 / 균형이 무너져서 / 이렇게 흔들리고 있는 거야. // 이대로라면 / 추락할 위험도 있다."},
    {"selector":"00/288","entry_index":2,"draft_translation":"저희에게 맡겨 주세요! / 록맨, 간다!"},

    {"selector":"00/289","entry_index":0,"draft_translation":"록맨, 우측 엔진 프로그램을 / 찾아 줘!!"},
    {"selector":"00/289","entry_index":1,"draft_translation":"응! // ...으앗!!"},
    {"selector":"00/289","entry_index":2,"draft_translation":"왜 그래, 록맨!?"},
    {"selector":"00/289","entry_index":3,"draft_translation":"비행기 안에 엄청난 / 자기력이 발생하고 있어!"},
    {"selector":"00/289","entry_index":4,"draft_translation":"록맨, 괜찮아!?"},
    {"selector":"00/289","entry_index":5,"draft_translation":"하아, 하아... 괜찮은 것 같지만 / 내 몸도 자기력을 / 띠게 된 모양이야... // 어쩌면 기내 자기력의 / 영향을 받을지도 모르지만... // 가는 수밖에 없지! / 넷토 군, 오퍼레이션 부탁해!"},

    {"selector":"00/290","entry_index":0,"draft_translation":"이걸로 우선 한시름 놓았네..."},
    {"selector":"00/290","entry_index":1,"draft_translation":"기장님! / 꼬리날개 프로그램에 이상 발생! / 제어가 되지 않습니다!"},
    {"selector":"00/290","entry_index":2,"draft_translation":"뭐라고!? / 꼬리날개를 제어할 수 없다니? / 조종 불능이 되고 말 거야!"},
    {"selector":"00/290","entry_index":3,"draft_translation":"록맨, 서둘러 / 꼬리날개 프로그램으로 가 줘!"},

    {"selector":"00/291","entry_index":0,"draft_translation":"후우[textSpeed delay=20]...[textSpeed delay=2]하나 해치웠다! // 고스펠 녀석들, / 다음엔 어디에 버그를 낼 작정이지?"},
    {"selector":"00/291","entry_index":1,"draft_translation":"삐―[wait 54]삐―[wait 54]삐―!![wait 54]"},
    {"selector":"00/291","entry_index":2,"draft_translation":"이번엔 또 뭐야!!"},
    {"selector":"00/291","entry_index":3,"draft_translation":"기내 기압이! / 계속 내려가고 있습니다!"},
    {"selector":"00/291","entry_index":4,"draft_translation":"뭐라고? / 이번엔 기압 조절 프로그램인가? // 지금 고도에서... / 이대로 기압이 계속 내려가면, // 고산병 때문에 / 자칫 사망자가 나올 수도 있어!"},
    {"selector":"00/291","entry_index":5,"draft_translation":"그, 그러고 보니 / 왠지 숨쉬기가 괴로운 것 같아... // 록맨, 기압 조절 프로그램이야! / 서둘러 줘!"},

    {"selector":"00/292","entry_index":0,"draft_translation":"후우, 숨 막혀 죽는 줄 알았네..."},
    {"selector":"00/292","entry_index":1,"draft_translation":"안 돼! 스로틀이 먹히지 않아!"}
  ],
  "review_notes": [
    "00/279의 メアカモッサドクグモ는 붉은 눈·북슬북슬한 털·독거미라는 조어의 구성 요소를 살려 붉은눈털북숭이독거미로 잠정 번역했다.",
    "00/290의 尾翼는 항공기 문맥에 맞춰 꼬리날개로 옮겼고 이후 같은 프로그램 명칭에 동일하게 적용한다.",
    "00/291의 textSpeed 20·2와 세 개의 wait 54 경보 연출은 원문 순서와 인자를 그대로 유지했다."
  ]
}
