{
  "schema_version": 1,
  "batch_number": 40,
  "entries": [
    {"selector":"00/237","entry_index":0,"draft_translation":"아빠! 마더 컴퓨터는!?"},
    {"selector":"00/237","entry_index":1,"draft_translation":"누군가 침입한 모양이야. / 이렇게 빨리 쳐들어오다니...! // 수수께끼의 내비를 물리칠 무기도 / 아직 완성하지 못했는데..."},
    {"selector":"00/237","entry_index":2,"draft_translation":"아빠, 우리가 갈게! / 그동안 아빠는 / 무기를 완성해 줘!"},
    {"selector":"00/237","entry_index":3,"draft_translation":"알았다! // 남아 있는 오피셜 넷배틀러들도 / 이미 움직이고 있으니 / 힘을 합쳐서 싸우거라!"},

    {"selector":"00/238","entry_index":0,"draft_translation":"크다! / 이게 마더 컴퓨터구나!"},
    {"selector":"00/238","entry_index":1,"draft_translation":"넷토 군! / 감탄하고 있을 때가 아니잖아! // 마더 컴퓨터를 빼앗기면 / 이 나라를 빼앗긴 거나 마찬가지야!"},

    {"selector":"00/239","entry_index":0,"draft_translation":"보안 시스템이 / 당한 모양이군... // 암호를 입력하지 않으면 / 문을 열 수 없겠어... // 응? 히카리 씨의 아들 아니냐? // 여긴 어쩐 일이니?"},
    {"selector":"00/239","entry_index":1,"draft_translation":"저도 돕게 해 주세요!"},
    {"selector":"00/239","entry_index":2,"draft_translation":"네가 와 주면 / 아주 든든하지! // 하지만 여기는 우리 아저씨들에게 / 맡겨 주렴! // 오피셜의 실력을 / 보여 주마!! // 자, 모두! 간다!"},
    {"selector":"00/239","entry_index":3,"draft_translation":"네!"},
    {"selector":"00/239","entry_index":4,"draft_translation":"라저!"},
    {"selector":"00/239","entry_index":5,"draft_translation":"플러그인!!"},
    {"selector":"00/239","entry_index":6,"draft_translation":"자, 전진한다!"},
    {"selector":"00/239","entry_index":7,"draft_translation":"어디 보자... / 여기 암호는..."},
    {"selector":"00/239","entry_index":8,"draft_translation":"오피셜 빔――――!"},
    {"selector":"00/239","entry_index":9,"draft_translation":"좋아, 이제 조금만 더!"},
    {"selector":"00/239","entry_index":10,"draft_translation":"네!"},
    {"selector":"00/239","entry_index":11,"draft_translation":"라저!"},
    {"selector":"00/239","entry_index":12,"draft_translation":"응!? 이 녀석 뭐야! / 바이러스가 아니잖아! / 너희도 힘을 보태 줘!"},
    {"selector":"00/239","entry_index":13,"draft_translation":"네!"},
    {"selector":"00/239","entry_index":14,"draft_translation":"라저!"},
    {"selector":"00/239","entry_index":15,"draft_translation":"퍽![wait 16] / 턱![wait 15] / 드륵![wait 14]"},
    {"selector":"00/239","entry_index":16,"draft_translation":"이대로는 위험해! / 그걸 써 줘!! 그거 말이야!"},
    {"selector":"00/239","entry_index":17,"draft_translation":"파바박![wait 19] / 쾅!"},
    {"selector":"00/239","entry_index":18,"draft_translation":"피이이이일사아아알!! / 오피셜 데 바르바로사 / 데인저러스 캐노오오온!!"},
    {"selector":"00/239","entry_index":19,"draft_translation":"콰아앙!"},
    {"selector":"00/239","entry_index":20,"draft_translation":"딜리트 완료!"},
    {"selector":"00/239","entry_index":21,"draft_translation":"어떠냐! 우리 아저씨들의 / 실력이!"},
    {"selector":"00/239","entry_index":22,"draft_translation":"역시 오피셜이야!"},
    {"selector":"00/239","entry_index":23,"draft_translation":"문이 열린다!"},

    {"selector":"00/240","entry_index":0,"draft_translation":"문 해제 프로그램 가동! // 이제 문이 / 열렸을 거야."},
    {"selector":"00/240","entry_index":1,"draft_translation":"너희를 / 먼저 보내 줄 수는 없다... // 여기서 숨을 거둬라!!"},
    {"selector":"00/240","entry_index":2,"draft_translation":"젠장! 이런 곳에서 / 꾸물거릴 시간은 / 없는데!"},
    {"selector":"00/240","entry_index":3,"draft_translation":"잠깐 기다려![wait 60]"},
    {"selector":"00/240","entry_index":4,"draft_translation":"우리가 상대다!! // 록맨! / 여긴 우리에게 맡겨! / 넌 힘을 아껴 두는 거야."},
    {"selector":"00/240","entry_index":5,"draft_translation":"끄덕."},
    {"selector":"00/240","entry_index":6,"draft_translation":"간 건가... // 콜록!"},
    {"selector":"00/240","entry_index":7,"draft_translation":"괜찮으세요!?..."},
    {"selector":"00/240","entry_index":8,"draft_translation":"아까 싸움으로 / 꽤 망가진 거 아니냐?"},
    {"selector":"00/240","entry_index":9,"draft_translation":"너희도 남 말 할 / 처지는 아니잖아... // 그나저나... / 저 내비... 강하군..."},
    {"selector":"00/240","entry_index":10,"draft_translation":"아마 정면으로 싸워서는 / 이길 수 없겠죠..."},
    {"selector":"00/240","entry_index":11,"draft_translation":"이길 방법은 / 하나뿐이군..."},
    {"selector":"00/240","entry_index":12,"draft_translation":"그래, 그 수밖에 없겠어. // 마더 컴퓨터를 위해 / 죽을 수 있다면 여한은 없다!! // 화끈하게 터뜨려 보자고!! // 풀 파워 모드 발동!!"},
    {"selector":"00/240","entry_index":13,"draft_translation":"풀 파워 모드라니..."},
    {"selector":"00/240","entry_index":14,"draft_translation":"설마 당신들!?"},
    {"selector":"00/240","entry_index":15,"draft_translation":"파워를 과부하시켜 / 자폭할 셈이야!?"},
    {"selector":"00/240","entry_index":16,"draft_translation":"신세 많이 졌다! 아저씨!"},
    {"selector":"00/240","entry_index":17,"draft_translation":"나머지는 록맨에게 맡길게!"},
    {"selector":"00/240","entry_index":18,"draft_translation":"잘 있어!!"},

    {"selector":"00/241","entry_index":0,"draft_translation":"블루스!!"},
    {"selector":"00/241","entry_index":1,"draft_translation":"이번 사건은 엔잔 님과 / 이 블루스가 해결한다!"},
    {"selector":"00/241","entry_index":2,"draft_translation":"...엔잔!!"},
    {"selector":"00/241","entry_index":3,"draft_translation":"설마 마더 컴퓨터를 / 직접 노릴 줄이야... // 이 사건은 / 오피셜 넷배틀러에게 맡겨라."},
    {"selector":"00/241","entry_index":4,"draft_translation":"무슨 소리야! / 그런 말이나 하고 있을 / 때가 아니잖아!"},
    {"selector":"00/241","entry_index":5,"draft_translation":"블루스! 간다!"},
    {"selector":"00/241","entry_index":6,"draft_translation":"네!"},
    {"selector":"00/241","entry_index":7,"draft_translation":"넷토 군! 우리도 가자!"},

    {"selector":"00/242","entry_index":0,"draft_translation":"친구가 도착했군... / 크크크..."},
    {"selector":"00/242","entry_index":1,"draft_translation":"블루스...!!"},
    {"selector":"00/242","entry_index":2,"draft_translation":"아무래도 이 녀석이 / 우두머리인 모양이군."},
    {"selector":"00/242","entry_index":3,"draft_translation":"지원할게!"},
    {"selector":"00/242","entry_index":4,"draft_translation":"손대지 마라! / 이 녀석은 내 먹잇감이다. // 미안하지만 / 네가 활약할 자리는 없다!"},
    {"selector":"00/242","entry_index":5,"draft_translation":"누구든 상관없으니 / 어서 덤벼! // 뭐, 둘이 한꺼번에 / 덤벼도 괜찮다고. // 겁쟁이 녀석들... / 내가 무서운 거냐? / 크크크..."},
    {"selector":"00/242","entry_index":6,"draft_translation":"큭! 말이면 다인 줄 알고!"},
    {"selector":"00/242","entry_index":7,"draft_translation":"보안 문은 / 이미 해제했다! // 히카리, 넌 메인 시스템을 / 조사하러 가라!"},
    {"selector":"00/242","entry_index":8,"draft_translation":"왜 네 명령을 / 들어야 하는데!"},
    {"selector":"00/242","entry_index":9,"draft_translation":"빨리 가!"},
    {"selector":"00/242","entry_index":10,"draft_translation":"넷토 군, 여기는 블루스와 / 엔잔 군에게 맡기자!"},
    {"selector":"00/242","entry_index":11,"draft_translation":"알았어!"},

    {"selector":"00/243","entry_index":0,"draft_translation":"호오, 여기까지 / 도착한 자가 있을 줄이야..."},
    {"selector":"00/243","entry_index":1,"draft_translation":"말도 안 돼!? 이 녀석은 / 블루스와 싸우고 있을 텐데..."},
    {"selector":"00/243","entry_index":2,"draft_translation":"흥..."},
    {"selector":"00/243","entry_index":3,"draft_translation":"그럼 블루스와 싸우는 / 섀도맨은 가짜야?"},
    {"selector":"00/243","entry_index":4,"draft_translation":"이제 와서 알아차려도 늦었다."},
    {"selector":"00/243","entry_index":5,"draft_translation":"넷토! 완성했다! / 섀도맨 대책용 배틀칩, // 「얼티밋 블래스터」다. // 이 칩의 위력이라면 / 섀도맨을 쓰러뜨릴 수 / 있을지도 몰라... // 하지만 쏠 수 있는 건 한 발뿐이다. / 완전한 물건을 만들 / 시간이 없었단다·[waitSkip 20]·[waitSkip 20]·[waitSkip 20] // 미안하다, 넷토."},
    {"selector":"00/243","entry_index":6,"draft_translation":"한 발이면 충분해! / 나와 록맨을 믿어 줘! // 「얼티밋 블래스터」 / 슬롯 인!"},
    {"selector":"00/243","entry_index":7,"draft_translation":"록맨, 기회는 한 번뿐이야!"},
    {"selector":"00/243","entry_index":8,"draft_translation":"응!"},
    {"selector":"00/243","entry_index":9,"draft_translation":"...흥, 그 무기로 이 몸을? // 빗나가면 어떻게 될지 / 알고 있겠지."},
    {"selector":"00/243","entry_index":10,"draft_translation":"! 빗나가면... / 마더 컴퓨터를 / 파괴하고 말 거야..."},
    {"selector":"00/243","entry_index":11,"draft_translation":"하지만 지금은 해야만 해! / ...그래도."},
    {"selector":"00/243","entry_index":12,"draft_translation":"애송이가..."},
    {"selector":"00/243","entry_index":13,"draft_translation":"젠장! 어떻게 해야 하지!?"},
    {"selector":"00/243","entry_index":14,"draft_translation":"푹!"},
    {"selector":"00/243","entry_index":15,"draft_translation":"뭣!?"},
    {"selector":"00/243","entry_index":16,"draft_translation":"어서 쏴! / 록맨!!"},
    {"selector":"00/243","entry_index":17,"draft_translation":"브, 블루스...! // 그럴 수 없어... 못 쏘겠어!"},
    {"selector":"00/243","entry_index":18,"draft_translation":"너는 일본을 / 아지나국처럼 만들고 싶은 거냐!?"},
    {"selector":"00/243","entry_index":19,"draft_translation":"...... // 그림자 무사를 쓰러뜨리고 왔나... / 하지만 상처 하나 없이 / 쓰러뜨리지는 못한 모양이군."},
    {"selector":"00/243","entry_index":20,"draft_translation":"커헉!! / 록맨...! // 서둘러라. 내 체력은 / 이제 오래 버티지 못한다! // 난 백업 데이터가 있으니 / 딜리트돼도 / 복구할 수 있다... // 쏴라! 록맨!"},
    {"selector":"00/243","entry_index":21,"draft_translation":"곧바로 백업 데이터를 / 복구해 줄게!"},
    {"selector":"00/243","entry_index":22,"draft_translation":"......"},
    {"selector":"00/243","entry_index":23,"draft_translation":"샥!"},
    {"selector":"00/243","entry_index":24,"draft_translation":"콰아아아아아앙!!"},
    {"selector":"00/243","entry_index":25,"draft_translation":"부, 부하 녀석들이... / 방패가... 되어 버렸...군. // 으윽!"},
    {"selector":"00/243","entry_index":26,"draft_translation":"엔잔 군! / 빨리 블루스를 / 플러그아웃시켜!"},
    {"selector":"00/243","entry_index":27,"draft_translation":"블루스!"},
    {"selector":"00/243","entry_index":28,"draft_translation":"아깝게 됐군..."},
    {"selector":"00/243","entry_index":29,"draft_translation":"큭!"},

    {"selector":"00/244","entry_index":0,"draft_translation":"설마 이 몸이 / 패할 줄이야...! // 다크 미야비 님... // 원통하다!"}
  ],
  "review_notes": [
    "00/239의 오피셜 팀 구호와 필살기 명칭은 희극적 말투를 살린 음역 초안이다.",
    "00/243의 アルティメット ブラスター는 얼티밋 블래스터로 임시 통일했다.",
    "00/244의 ダーク・ミヤビ는 고유명사 다크 미야비로 음역했으며 후속 문맥 검토가 필요하다."
  ]
}
