{
 "schema_version": 1,
 "batch_number": 36,
 "entries": [
  {
   "selector": "00/179",
   "entry_index": 9,
   "draft_translation": "응! 아!"
  },
  {
   "selector": "00/179",
   "entry_index": 10,
   "draft_translation": "제길! 역시 가스 온수기를 / 어떻게든 하지 않으면 / 안 되는 건가!"
  },
  {
   "selector": "00/179",
   "entry_index": 11,
   "draft_translation": "응! 하지만 잠깐만!"
  },
  {
   "selector": "00/180",
   "entry_index": 0,
   "draft_translation": "넷토 군! 방금 그걸로 / 이쪽 가스가 사라졌어! / 환풍기 프로그램이 있어! // 응! 그럼 그걸! // 앗!"
  },
  {
   "selector": "00/180",
   "entry_index": 1,
   "draft_translation": "호아―![waitSkip 30] // 누구냐―, 이런 짓을 하는 건―[waitSkip 30] // 호아―!"
  },
  {
   "selector": "00/180",
   "entry_index": 2,
   "draft_translation": "록맨!"
  },
  {
   "selector": "00/180",
   "entry_index": 3,
   "draft_translation": "응! 저 녀석이 / 이 가스의 원인인 것 같아!"
  },
  {
   "selector": "00/181",
   "entry_index": 0,
   "draft_translation": "집 안의 가스, 네 짓이구나! / 당장 가스를 멈춰!"
  },
  {
   "selector": "00/181",
   "entry_index": 1,
   "draft_translation": "호아―![waitSkip 30] // 그건― 불가능하다―![waitSkip 30] // 호아―!!"
  },
  {
   "selector": "00/181",
   "entry_index": 2,
   "draft_translation": "소용없어![waitSkip 30] // 에어맨은 오직 내 명령만 / 들으니까!"
  },
  {
   "selector": "00/181",
   "entry_index": 3,
   "draft_translation": "!? 아까 그 가스 회사 직원![waitSkip 30] // 가스 회사 직원이면서 / 왜 이런 짓을 하는 거야!?"
  },
  {
   "selector": "00/181",
   "entry_index": 4,
   "draft_translation": "회사 따윈 상관없어! / 내겐 더 큰 목적이 있거든!"
  },
  {
   "selector": "00/181",
   "entry_index": 5,
   "draft_translation": "야이토에게 원한이라도 있는 거야?"
  },
  {
   "selector": "00/181",
   "entry_index": 6,
   "draft_translation": "없어! 부잣집 아이라면 / 누구든 상관없었지! / 그렇게 해 놓고 다음에는, // 「돈을 내놓지 않으면 / 네 아이가 가스에 죽는다!」고 / 부모들을 협박하면, // 1억 제니든 2억 제니든 / 뜯어낼 수 있으니까!"
  },
  {
   "selector": "00/181",
   "entry_index": 7,
   "draft_translation": "이 자식! 정말 못돼먹었어!"
  },
  {
   "selector": "00/181",
   "entry_index": 8,
   "draft_translation": "돈 때문에 아이를 노리다니! / 난 이런 사람을 용서할 수 없어!"
  },
  {
   "selector": "00/181",
   "entry_index": 9,
   "draft_translation": "마음대로 지껄여! / 너도 이대로 가스를 마시고 / 죽게 될 테니까!"
  },
  {
   "selector": "00/181",
   "entry_index": 10,
   "draft_translation": "그렇게 뜻대로는 안 돼![waitSkip 30] // 간다, 록맨![waitSkip 30] // 배틀 오퍼레이션! / 세트![waitSkip 30]"
  },
  {
   "selector": "00/181",
   "entry_index": 11,
   "draft_translation": "인!"
  },
  {
   "selector": "00/182",
   "entry_index": 0,
   "draft_translation": "해냈어!"
  },
  {
   "selector": "00/182",
   "entry_index": 1,
   "draft_translation": "해냈구나!"
  },
  {
   "selector": "00/182",
   "entry_index": 2,
   "draft_translation": "내가 이런 꼬마 따위에게...[waitSkip 30] / ·[waitSkip 30] / ·[waitSkip 30] // 하지만...[waitSkip 30] // 좋아! / 다음에는 이렇게 안 될 거다! // 우리 조직은 최강이니까! / 잘 있어라!"
  },
  {
   "selector": "00/182",
   "entry_index": 3,
   "draft_translation": "...도망쳤어.[waitSkip 30] // 그보다 록맨![waitSkip 30] // 야이토부터!"
  },
  {
   "selector": "00/182",
   "entry_index": 4,
   "draft_translation": "응!"
  },
  {
   "selector": "00/182",
   "entry_index": 5,
   "draft_translation": "딸깍!"
  },
  {
   "selector": "00/182",
   "entry_index": 6,
   "draft_translation": "이쪽은 끝났어! / 빨리 야이토를 구해 줘!"
  },
  {
   "selector": "00/183",
   "entry_index": 0,
   "draft_translation": "·[waitSkip 30] / ·[waitSkip 30] / ·[waitSkip 30] // 으,[waitSkip 30] // 으―[waitSkip 30] // ...음."
  },
  {
   "selector": "00/183",
   "entry_index": 1,
   "draft_translation": "정신이 들었어!"
  },
  {
   "selector": "00/183",
   "entry_index": 2,
   "draft_translation": "야이토![waitSkip 30] // 괜찮아?"
  },
  {
   "selector": "00/183",
   "entry_index": 3,
   "draft_translation": "어라...[waitSkip 30] / ·[waitSkip 30] / ·[waitSkip 30] // 나 목욕을..."
  },
  {
   "selector": "00/183",
   "entry_index": 4,
   "draft_translation": "가스를 마시고 정신을 잃었어.[waitSkip 30] // 넷토가 구해 줬고."
  },
  {
   "selector": "00/183",
   "entry_index": 5,
   "draft_translation": "히카리 군이..."
  },
  {
   "selector": "00/183",
   "entry_index": 6,
   "draft_translation": "헷."
  },
  {
   "selector": "00/183",
   "entry_index": 7,
   "draft_translation": "...그런데 너, / 설마 숙녀의 알몸을!"
  },
  {
   "selector": "00/183",
   "entry_index": 8,
   "draft_translation": "안 봤어!"
  },
  {
   "selector": "00/183",
   "entry_index": 9,
   "draft_translation": "그럴 리 없잖아![waitSkip 30] / 잠깐! // 책임지란 말이야!"
  },
  {
   "selector": "00/183",
   "entry_index": 10,
   "draft_translation": "넷토는 거짓말하지 않았어. // 가스를 멈춘 건 넷토지만 / 야이토를 여기까지 옮긴 건 / 나니까."
  },
  {
   "selector": "00/183",
   "entry_index": 11,
   "draft_translation": "현관문 잠금을 푼 건 / 나라고!"
  },
  {
   "selector": "00/183",
   "entry_index": 12,
   "draft_translation": "흐―응, 그렇구나.[waitSkip 30] // 히카리 군, 내 알몸을 못 봐서 / 아쉬웠겠네―"
  },
  {
   "selector": "00/183",
   "entry_index": 13,
   "draft_translation": "쳇, 여전히 / 말로는 못 당하겠다니까―!"
  },
  {
   "selector": "00/184",
   "entry_index": 0,
   "draft_translation": "그 무렵...[waitSkip 30] / ·[waitSkip 30] / ·[waitSkip 30]"
  },
  {
   "selector": "00/184",
   "entry_index": 1,
   "draft_translation": "여보세요,[waitSkip 30] // 아라시입니다."
  },
  {
   "selector": "00/184",
   "entry_index": 2,
   "draft_translation": "유감스러운 결과로 / 끝난 모양이군..."
  },
  {
   "selector": "00/184",
   "entry_index": 3,
   "draft_translation": "조금 실수했을 뿐이야.[waitSkip 30] // 뭐, 다음 기회에 만회하지!"
  },
  {
   "selector": "00/184",
   "entry_index": 4,
   "draft_translation": "자네는 우리 「고스펠」이 / 얼마나 엄격한지 모르는 모양이군..."
  },
  {
   "selector": "00/184",
   "entry_index": 5,
   "draft_translation": "어이, 너무 호들갑 떠는 거 아냐?"
  },
  {
   "selector": "00/184",
   "entry_index": 6,
   "draft_translation": "우리는 전 세계에서 / 넷마피아라 불리며 두려움의 대상이다. / 이 일본에서도 곧 그렇게 될 것이다."
  },
  {
   "selector": "00/184",
   "entry_index": 7,
   "draft_translation": "그래서 어쨌다는 거야!"
  },
  {
   "selector": "00/184",
   "entry_index": 8,
   "draft_translation": "아니, 이제 됐다. / 자네에게 다음 기회는 없어."
  },
  {
   "selector": "00/184",
   "entry_index": 9,
   "draft_translation": "하! 그렇다면 / 나도 사양하겠어!"
  },
  {
   "selector": "00/184",
   "entry_index": 10,
   "draft_translation": "그럼...[waitSkip 30] // 잘 가도록...[waitSkip 30] // 폭발까지 앞으로 3초다..."
  },
  {
   "selector": "00/184",
   "entry_index": 11,
   "draft_translation": "뭐라고!"
  },
  {
   "selector": "00/184",
   "entry_index": 12,
   "draft_translation": "째깍[wait 45] // 째깍[wait 45] // 째깍[wait 45]"
  },
  {
   "selector": "00/184",
   "entry_index": 13,
   "draft_translation": "저건가!"
  },
  {
   "selector": "00/184",
   "entry_index": 14,
   "draft_translation": "흥, 우리를...[waitSkip 30] // 「고스펠」을 얕보면 곤란하지!"
  },
  {
   "selector": "00/185",
   "entry_index": 0,
   "draft_translation": "방학이 시작되고 며칠이 지난 / 어느 날...[wait 60]"
  },
  {
   "selector": "00/185",
   "entry_index": 1,
   "draft_translation": "넷토 군, 가끔은 / 놀러 나가기 전에 숙제부터 / 해야 하지 않겠어?"
  },
  {
   "selector": "00/185",
   "entry_index": 2,
   "draft_translation": "딱딱한 소리 하지 마! / 방학은 아직 많이 남았잖아! // 아―, 방학은 최고라니까! / 오늘은 뭘 하며 놀까―!"
  },
  {
   "selector": "00/185",
   "entry_index": 3,
   "draft_translation": "정말! 나중에 곤란해져도 / 난 모른다! // 그래도 어차피 놀 거라면 / 추억에 남을 일을 하자!"
  },
  {
   "selector": "00/185",
   "entry_index": 4,
   "draft_translation": "음―, 그것도 그렇네...[waitSkip 30] // 그럼 바다에 갈까? / 아니면 산으로 갈까?"
  },
  {
   "selector": "00/185",
   "entry_index": 5,
   "draft_translation": "둘 다 좋은데, 어디로 갈래?"
  },
  {
   "selector": "00/185",
   "entry_index": 6,
   "draft_translation": "좋아! 그럼 산![waitSkip 30] // 다 같이 캠핑하러 가자!"
  },
  {
   "selector": "00/186",
   "entry_index": 0,
   "draft_translation": "쳇... / 다들 꽤 바쁜가 보네."
  },
  {
   "selector": "00/186",
   "entry_index": 1,
   "draft_translation": "역시 갑자기 정한 게 / 문제였던 모양이야..."
  },
  {
   "selector": "00/186",
   "entry_index": 2,
   "draft_translation": "그런가 봐."
  },
  {
   "selector": "00/186",
   "entry_index": 3,
   "draft_translation": "오늘은 이제 뭐 하지?"
  },
  {
   "selector": "00/186",
   "entry_index": 4,
   "draft_translation": "글쎄..."
  },
  {
   "selector": "00/186",
   "entry_index": 5,
   "draft_translation": "응?"
  },
  {
   "selector": "00/186",
   "entry_index": 6,
   "draft_translation": "삐삐삐!!"
  },
  {
   "selector": "00/186",
   "entry_index": 7,
   "draft_translation": "메일이다. 읽을까?"
  },
  {
   "selector": "00/186",
   "entry_index": 8,
   "draft_translation": "응."
  },
  {
   "selector": "00/186",
   "entry_index": 9,
   "draft_translation": "[printItem item=58]를 소지하신 여러분께 // 오피셜 센터에서는 현재 / 새로운 시민 넷배틀러를 / 모집하고 있습니다. // 라이선스 시험에 합격하면 / 당신도 시민 넷배틀러의 일원! // 이번 기회를 놓치지 마세요! / 마린하버의 오피셜 센터로 / 방문해 주십시오!"
  },
  {
   "selector": "00/186",
   "entry_index": 10,
   "draft_translation": "흐―음."
  },
  {
   "selector": "00/186",
   "entry_index": 11,
   "draft_translation": "있지! 이거 보러 가자! / 한번 가 보자! // 라이선스를 따면 / 분명 좋은 일이 있을 거야!"
  },
  {
   "selector": "00/186",
   "entry_index": 12,
   "draft_translation": "음―, 오늘은 할 일도 / 없어져 버렸고...[waitSkip 30] / ·[waitSkip 30] / ·[waitSkip 30] // 가 볼까!"
  },
  {
   "selector": "00/186",
   "entry_index": 13,
   "draft_translation": "그래야지! // 그럼 캠핑은 내일 가는 걸로 / 모두에게 연락해 둘게!"
  },
  {
   "selector": "00/187",
   "entry_index": 0,
   "draft_translation": "드디어 시험이네! / 시험이라니 왠지 긴장되는데..."
  },
  {
   "selector": "00/187",
   "entry_index": 1,
   "draft_translation": "그렇지! 내가 공부를 싫어하는 거 / 너도 알잖아?"
  },
  {
   "selector": "00/187",
   "entry_index": 2,
   "draft_translation": "아, 네가 공부 안 하는 핑계로 / 남을 끌어들였지!"
  },
  {
   "selector": "00/187",
   "entry_index": 3,
   "draft_translation": "그런 거 아니라니까! / 자! 어서 시험이나 보자!!"
  },
  {
   "selector": "00/187",
   "entry_index": 4,
   "draft_translation": "정말, 넷토 군도 참![waitSkip 30] // 그럼 내가 열심히 할 테니 / 오퍼레이션 부탁해!"
  },
  {
   "selector": "00/189",
   "entry_index": 0,
   "draft_translation": "내, 내가 졌어! 이걸 돌려줄 테니 / 좀 봐 달라고..."
  },
  {
   "selector": "00/189",
   "entry_index": 1,
   "draft_translation": "록맨은 / 「[printItem item=5]」을 / 획득했다!!"
  },
  {
   "selector": "00/189",
   "entry_index": 2,
   "draft_translation": "식은 죽 먹기였지? / 자, 「[printItem item=5]」을 / 아까 그 내비에게 돌려주러 가자!"
  },
  {
   "selector": "00/191",
   "entry_index": 0,
   "draft_translation": "그리고...[waitSkip 30] / ·[waitSkip 30] / ·[waitSkip 30] // 넷토와 록맨이 잠든 무렵...[waitSkip 30] / ·[waitSkip 30] / ·[waitSkip 30]"
  },
  {
   "selector": "00/191",
   "entry_index": 1,
   "draft_translation": "응?"
  },
  {
   "selector": "00/191",
   "entry_index": 2,
   "draft_translation": "...[waitSkip 30] // 이 게시물은?"
  },
  {
   "selector": "00/191",
   "entry_index": 3,
   "draft_translation": "무슨 일이지?[waitSkip 30] // 블루스!"
  },
  {
   "selector": "00/191",
   "entry_index": 4,
   "draft_translation": "엔잔 님, 이것을 보십시오. / 이런 게시물이..."
  },
  {
   "selector": "00/191",
   "entry_index": 5,
   "draft_translation": "PET 화면에 띄워라."
  },
  {
   "selector": "00/191",
   "entry_index": 6,
   "draft_translation": "예!"
  },
  {
   "selector": "00/191",
   "entry_index": 7,
   "draft_translation": "「일본 국민 여러분께. / 내일 세계의 「고스펠」이 지닌 / 위대함을 보여 드리겠습니다.[waitSkip 30] // ...[waitSkip 30] // 에서 많은 사람이 희생될 것입니다... // 기대해 주십시오.」"
  },
  {
   "selector": "00/191",
   "entry_index": 8,
   "draft_translation": "범행 예고인가...[waitSkip 30] // 흥, 쓰레기 같은 놈![waitSkip 30] // ...쓸데없는 글을 올리다니![waitSkip 30]"
  },
  {
   "selector": "00/191",
   "entry_index": 9,
   "draft_translation": "·[waitSkip 30] / ·[waitSkip 30] / ·[waitSkip 30]"
  },
  {
   "selector": "00/191",
   "entry_index": 10,
   "draft_translation": "블루스![waitSkip 30] // 「오피셜 넷배틀러 권한」으로 / 그 게시물을 삭제해 둬라! // 거짓 정보라고 생각하지만 / 내버려 두면 곧이듣고 / 소란을 피울 녀석이 반드시 생긴다."
  },
  {
   "selector": "00/191",
   "entry_index": 11,
   "draft_translation": "예!"
  },
  {
   "selector": "00/192",
   "entry_index": 0,
   "draft_translation": "...넷토 군―..."
  },
  {
   "selector": "00/192",
   "entry_index": 1,
   "draft_translation": "으음...[waitSkip 30] / ·[waitSkip 30] / ·[waitSkip 30]"
  },
  {
   "selector": "00/192",
   "entry_index": 2,
   "draft_translation": "넷토 군! 넷토 군이라니까!"
  },
  {
   "selector": "00/192",
   "entry_index": 3,
   "draft_translation": "으,[waitSkip 30] // 으...[waitSkip 30] // 음―."
  }
 ]
}
