  "entries": [
    {
      "selector": "00/366",
      "entry_index": 40,
      "draft_translation": "일단 한 건 해결됐네. / 슬슬 집에 갈까?"
    },
    {
      "selector": "00/366",
      "entry_index": 41,
      "draft_translation": "시작부터 이렇다면 / 대체 어떤 휴일이 될까? // 내일부터를 대비해서 / 오늘은 슬슬 잘까?"
    },
    {
      "selector": "00/366",
      "entry_index": 45,
      "draft_translation": "모두에게 캠프 가자고 해 보자!"
    },
    {
      "selector": "00/366",
      "entry_index": 46,
      "draft_translation": "오피셜 센터에 / 라이선스 시험을 보러 가자!"
    },
    {
      "selector": "00/366",
      "entry_index": 48,
      "draft_translation": "넷토, 시험은 / 오피셜 센터 안에서 봐야지?"
    },
    {
      "selector": "00/366",
      "entry_index": 51,
      "draft_translation": "넷토, 시험은 어떻게 할 거야? / 다시 시험장에서 / 플러그인하자!"
    },
    {
      "selector": "00/366",
      "entry_index": 55,
      "draft_translation": "넷토, / 지금 라이선스 시험 중이잖아? / 플러그인하지 않아도 돼?"
    },
    {
      "selector": "00/366",
      "entry_index": 57,
      "draft_translation": "내일은 캠프니까 / 너무 늦기 전에 / 집에 돌아가야 해!"
    },
    {
      "selector": "00/366",
      "entry_index": 58,
      "draft_translation": "내일 캠프 가야 하니까 / 오늘은 늦게 자면 안 돼!"
    },
    {
      "selector": "00/366",
      "entry_index": 60,
      "draft_translation": "넷토! / 빨리 약속 장소로 가자!"
    },
    {
      "selector": "00/366",
      "entry_index": 80,
      "draft_translation": "있지, 바로 인터넷을 통해 / 아지나국에 가 보자."
    },
    {
      "selector": "00/366",
      "entry_index": 81,
      "draft_translation": "A 라이선스 시험을 보러 가자!"
    },
    {
      "selector": "00/366",
      "entry_index": 82,
      "draft_translation": "오피셜 센터의 / 의뢰 게시판을 보러 가자."
    },
    {
      "selector": "00/366",
      "entry_index": 83,
      "draft_translation": "빨리 시험을 볼 수 있도록 / 특별 임무를 해내자."
    },
    {
      "selector": "00/366",
      "entry_index": 84,
      "draft_translation": "넷토, 시험 보러 가자."
    },
    {
      "selector": "00/366",
      "entry_index": 90,
      "draft_translation": "넷토, 시험 중인데 / 어디 가는 거야?"
    },
    {
      "selector": "00/366",
      "entry_index": 91,
      "draft_translation": "아지나국의 인터넷은 / 어떤 모습일까? // 빨리 보고 싶다."
    },
    {
      "selector": "00/366",
      "entry_index": 92,
      "draft_translation": "외국 인터넷은 처음이라 / 두근두근하네."
    },
    {
      "selector": "00/366",
      "entry_index": 93,
      "draft_translation": "있지, 아지나에는 안 가?"
    },
    {
      "selector": "00/366",
      "entry_index": 100,
      "draft_translation": "아지나에서 무슨 일이 있었는지 / 조사하러 가자."
    },
    {
      "selector": "00/366",
      "entry_index": 101,
      "draft_translation": "아지나에서 들린 / 그 덜컹거리는 소리... // 대체 뭐였을까?"
    },
    {
      "selector": "00/366",
      "entry_index": 102,
      "draft_translation": "아지나에서 들린 / 수수께끼 소리의 정체를 / 확인하러 가자."
    },
    {
      "selector": "00/366",
      "entry_index": 105,
      "draft_translation": "아빠에게 가 봐야 해."
    },
    {
      "selector": "00/366",
      "entry_index": 106,
      "draft_translation": "게시판에 글을 쓰러 가자."
    },
    {
      "selector": "00/366",
      "entry_index": 107,
      "draft_translation": "정보를 모아야 해."
    },
    {
      "selector": "00/366",
      "entry_index": 108,
      "draft_translation": "슬슬 답글이 올라왔을까?"
    },
    {
      "selector": "00/366",
      "entry_index": 110,
      "draft_translation": "프로그램을 잘 아는 사람을 찾자."
    },
    {
      "selector": "00/366",
      "entry_index": 111,
      "draft_translation": "「[printItem item=21]」... / 어디에 있을까?"
    },
    {
      "selector": "00/366",
      "entry_index": 112,
      "draft_translation": "「[printItem item=21]」, / 설마 거기에 있을 줄이야."
    },
    {
      "selector": "00/366",
      "entry_index": 120,
      "draft_translation": "이 프로그램으로 / 내 성능도 올라갈까? // 빨리 설치해 달라고 하자."
    },
    {
      "selector": "00/366",
      "entry_index": 121,
      "draft_translation": "넷토, 긴급 상황이야! / 서두르자!"
    },
    {
      "selector": "00/366",
      "entry_index": 122,
      "draft_translation": "꾸물거릴 틈이 없어! / 서두르자!"
    },
    {
      "selector": "00/366",
      "entry_index": 123,
      "draft_translation": "일분일초가 급한데 / 어디 가는 거야?"
    },
    {
      "selector": "00/366",
      "entry_index": 130,
      "draft_translation": "일본의 네트워크 사회가 / 위기에 빠졌는데 / 어디 가는 거야!?"
    },
    {
      "selector": "00/366",
      "entry_index": 140,
      "draft_translation": "그럼 바로 / 아메롭파로 출발하자! / ...그런데 어떻게 가는 걸까?"
    },
    {
      "selector": "00/366",
      "entry_index": 141,
      "draft_translation": "여행은 준비부터! / 여권을 받으러 가자!"
    },
    {
      "selector": "00/366",
      "entry_index": 143,
      "draft_translation": "공항으로 가자! / 모두와도 잠시 작별이네."
    },
    {
      "selector": "00/366",
      "entry_index": 145,
      "draft_translation": "넷토! 이제 아메롭파에 갈 / 준비는 끝난 거 아니야?"
    },
    {
      "selector": "00/366",
      "entry_index": 181,
      "draft_translation": "드디어 일본에 돌아왔네. / 모두에게 다녀왔다고 하러 가자!"
    },
    {
      "selector": "00/366",
      "entry_index": 182,
      "draft_translation": "넷토, 긴 여행으로 피곤하지? / 슬슬 잘까?"
    },
    {
      "selector": "00/366",
      "entry_index": 200,
      "draft_translation": "넷토, 아지나 에어리어로 / 롤을 찾으러 가자!"
    },
    {
      "selector": "00/366",
      "entry_index": 201,
      "draft_translation": "인터넷에서 받은 / 얼음 조각을 / 아빠에게 보여 드리자!"
    },
    {
      "selector": "00/366",
      "entry_index": 202,
      "draft_translation": "자, 넷토. 아지나 에어리어로 / 서두르자! / 롤을 빨리 찾아야 해."
    },
    {
      "selector": "00/366",
      "entry_index": 203,
      "draft_translation": "인터넷에서 대체 무슨 일이 / 벌어진 걸까? / 어딘가에서 정보를 모으자!"
    },
    {
      "selector": "00/366",
      "entry_index": 204,
      "draft_translation": "암흑 의사를 불러낼 키워드라... / 우라 스퀘어에 가면 뭔가 알 수 있을까?"
    },
    {
      "selector": "00/366",
      "entry_index": 205,
      "draft_translation": "아메롭파 스퀘어에 있는 / 보라색 내비라... / 정말 있을까?"
    },
    {
      "selector": "00/366",
      "entry_index": 206,
      "draft_translation": "보라색 내비는 / 인터넷에서 쇼핑하고 / 있는 모양이네."
    },
    {
      "selector": "00/366",
      "entry_index": 207,
      "draft_translation": "WWW... 신경 쓰이는 키워드네. / 어쨌든 우라 게시판에 / 글을 쓰러 가자!"
    },
    {
      "selector": "00/366",
      "entry_index": 210,
      "draft_translation": "소문이 사실이라면 / 우라 스퀘어에 암흑 의사가 / 있을 텐데..."
    },
    {
      "selector": "00/366",
      "entry_index": 211,
      "draft_translation": "「[printItem item=36]」, / 불을 일으키는 프로그램 같아. / 어디에 있을까?"
    },
    {
      "selector": "00/366",
      "entry_index": 212,
      "draft_translation": "암흑 의사에게 / 백신을 만들어 달라고 하자."
    },
    {
      "selector": "00/366",
      "entry_index": 213,
      "draft_translation": "암흑 의사의 지인인 내비를 / 찾으러 가자!"
    },
    {
      "selector": "00/366",
      "entry_index": 214,
      "draft_translation": "열쇠 장인을 / 찾으러 가자!"
    },
    {
      "selector": "00/366",
      "entry_index": 215,
      "draft_translation": "열쇠 장인의 / 형에게 돌아가자."
    },
    {
      "selector": "00/366",
      "entry_index": 216,
      "draft_translation": "남은 「파란 조각」은 / 어디에 있을까?"
    },
    {
      "selector": "00/366",
      "entry_index": 217,
      "draft_translation": "넷토, / 암흑 의사에게 가자!"
    },
    {
      "selector": "00/366",
      "entry_index": 220,
      "draft_translation": "넷토, 우라 인터넷 3으로 / 이어지는 다른 길을 찾자."
    },
    {
      "selector": "00/366",
      "entry_index": 221,
      "draft_translation": "엔잔의 메일에 적혀 있던 / 길로 가 보자!"
    },
    {
      "selector": "00/366",
      "entry_index": 222,
      "draft_translation": "설마 거기가 고스펠의 / 본거지였다니...! / 서두르자!!"
    },
    {
      "selector": "00/366",
      "entry_index": 226,
      "draft_translation": "자, 넷토. / 집에 가자! 엄마가 분명 / 걱정하고 계실 거야."
    },
    {
      "selector": "00/366",
      "entry_index": 227,
      "draft_translation": "이제 괜찮다고 / 엄마를 안심시켜 드리자."
    },
    {
      "selector": "00/366",
      "entry_index": 228,
      "draft_translation": "넷토, 오늘은 이제 잘까?"
    },
    {
      "selector": "00/366",
      "entry_index": 240,
      "draft_translation": "넷토! 코토부키 스퀘어를 / 다시 조사해 보자! / 플러그인 부탁해!!"
    },
    {
      "selector": "00/366",
      "entry_index": 242,
      "draft_translation": "코토부키 마을로 가는 방법을 / 아빠와 상의해 보자!"
    },
    {
      "selector": "00/366",
      "entry_index": 243,
      "draft_translation": "코토부키 마을... / 고스펠의 본거지로 쳐들어가자!!"
    },
    {
      "selector": "00/367",
      "entry_index": 0,
      "draft_translation": "L 버튼을 누르면 / 넷토와 록맨이 대화할 수 있다! / (여기는 아직 안 들어갔습니다)"
    },
    {
      "selector": "00/367",
      "entry_index": 45,
      "draft_translation": "메일과 친구들이 / 마린하버에 와 있을까?"
    },
    {
      "selector": "00/367",
      "entry_index": 46,
      "draft_translation": "오피셜 센터에 / 라이선스 시험을 보러 가자!"
    },
    {
      "selector": "00/367",
      "entry_index": 47,
      "draft_translation": "음... 시험은 / 어디서 어떻게 보는 걸까?"
    },
    {
      "selector": "00/367",
      "entry_index": 48,
      "draft_translation": "빨리 시험장으로 가자!"
    },
    {
      "selector": "00/367",
      "entry_index": 49,
