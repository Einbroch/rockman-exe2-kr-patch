{
  "schema_version": 1,
  "batch_number": 39,
  "entries": [
    {"selector":"00/220","entry_index":4,"draft_translation":"아지나어 같아. / 번역 시스템 기동!"},
    {"selector":"00/220","entry_index":5,"draft_translation":"삐빅!"},
    {"selector":"00/220","entry_index":6,"draft_translation":"누구냐!?"},
    {"selector":"00/220","entry_index":7,"draft_translation":"나는 록맨. / 이 나라에서 날아온 / 풍선을 주웠어. // 보낸 사람을 만나려고 / 일본에서 온 거야. // 있지, 여기서 무슨 일이 있었어?"},
    {"selector":"00/220","entry_index":8,"draft_translation":"그게... / 나도 모르겠어... // 평소보다 늦게 플러그인했더니 / 아지나 스퀘어가 이 꼴이었고 / 국왕 폐하가 쓰러져 계셨어... // 그러고 보니 너, / 일본에서 왔다고 했지? // 폐하께서 돌아가시기 직전에 / 이 나라를 멸망시킨 녀석들의 / 다음 목표는... // 일본이라고 하셨어!!"},
    {"selector":"00/220","entry_index":9,"draft_translation":"뭐라고!?"},
    {"selector":"00/220","entry_index":10,"draft_translation":"서둘러 일본으로 돌아가야 해!"},
    {"selector":"00/220","entry_index":11,"draft_translation":"그렇게는 못 하지."},
    {"selector":"00/220","entry_index":12,"draft_translation":"누구냐!?"},
    {"selector":"00/220","entry_index":13,"draft_translation":"고스펠 아지나 공략 부대 / 부대장, // 컷맨!"},
    {"selector":"00/220","entry_index":14,"draft_translation":"뭐, 부대장이라고 해도 // 대장이 괴멸시킨 나라에 / 생존자가 없는지 조사하는 게 / 내 일이지만 말이야. // 대장은 지금쯤 / 일본으로 가고 있지 않을까?"},
    {"selector":"00/220","entry_index":15,"draft_translation":"또 고스펠이냐!!"},

    {"selector":"00/221","entry_index":0,"draft_translation":"크악! // 다, 당해 버린 모양이네... // 그, 그래도 나를 이겼다고 / 안심하면 안 돼... // 지금 일본으로 가고 있는 / 섀도맨 대장의 힘은 / 나와는 비교도 안 되니까... // 지금의 너로는 이길 수 없... 으아악!"},
    {"selector":"00/221","entry_index":1,"draft_translation":"괜찮아? / 다친 데 없어?"},
    {"selector":"00/221","entry_index":2,"draft_translation":"응, 고마워. / 괜찮아. // 있잖아, 네가 주운 풍선을 / 날려 보낸 건 나야. // 그저 친구를 / 사귀고 싶었을 뿐인데... / 이런 일에 휘말리게 해서 // ·[waitSkip 20]·[waitSkip 20]·[waitSkip 20] // 미안해."},
    {"selector":"00/221","entry_index":3,"draft_translation":"신경 쓰지 마! / 섀도맨이라는 녀석을 쓰러뜨리면 / 다시 여기로 올 테니까. // 그때 느긋하게 이야기하자!! // 록맨, 일단 집으로 돌아가서 / 정보를 정리한 다음 / 아빠한테 가자!!"},
    {"selector":"00/221","entry_index":4,"draft_translation":"응!!"},

    {"selector":"00/222","entry_index":0,"draft_translation":"아지나 괴멸로부터 / 몇 시간 뒤...[wait 90]"},
    {"selector":"00/222","entry_index":1,"draft_translation":"아지나에서 긴급 연락! // 고스펠을 자칭하는 / 수수께끼의 내비가 공격해... // 아지나 스퀘어는·[waitSkip 30]·[waitSkip 30]·[waitSkip 30] // 괴멸했습니다!!!"},
    {"selector":"00/222","entry_index":2,"draft_translation":"뭐라고!? // 아지나의 보안은 / 세계에서도 최고 수준일 텐데!"},
    {"selector":"00/222","entry_index":3,"draft_translation":"아지나 스퀘어를 / 괴멸시킬 힘을 지닌 / 고스펠의 내비라... // 위험하군..."},
    {"selector":"00/222","entry_index":4,"draft_translation":"타다닥...[wait 88] // 삐빅!"},
    {"selector":"00/222","entry_index":5,"draft_translation":"계속해서 / 아지나에서 긴급 연락! // 아지나를 습격한 내비의 / 다음 목표는·[waitSkip 30]·[waitSkip 30]·[waitSkip 30] // !!"},
    {"selector":"00/222","entry_index":6,"draft_translation":"왜 그러지! / 계속 읽게!"},
    {"selector":"00/222","entry_index":7,"draft_translation":"아, 아지나를 습격한 내비의 / 다음 목표는...!! // 일본!...입니다."},
    {"selector":"00/222","entry_index":8,"draft_translation":"뭐, 뭐라고!"},
    {"selector":"00/222","entry_index":9,"draft_translation":"...실례하겠습니다."},
    {"selector":"00/222","entry_index":10,"draft_translation":"이쥬인 군, 어디 가는 건가!?"},
    {"selector":"00/222","entry_index":11,"draft_translation":"조사하러 갑니다.[waitSkip 30] // 여기서 손 놓고 있을 / 시간은 없습니다... // 그렇지 않습니까?"},
    {"selector":"00/222","entry_index":12,"draft_translation":"이쥬인 군 말이 맞네. / 서둘러 손을 쓰도록 하지. // 나는 그 내비에 대항할 / 강력한 무기 프로그램을 / 만들겠네! // 모두는 전국의 / 오피셜 넷배틀러에게 연락을! // 외부 해킹에 대비해 / 제1종 비상 경계 태세를 / 취해 주게!"},
    {"selector":"00/222","entry_index":13,"draft_translation":"좋아! 전국의 / 오피셜 넷배틀러에게 연락해! // 제1종 비상 경계 태세다!!"},
    {"selector":"00/222","entry_index":14,"draft_translation":"제1종 비상 경계 태세!"},

    {"selector":"00/223","entry_index":0,"draft_translation":"넷토 군, 일본에 위기가 / 닥쳤다는 걸 빨리..."},
    {"selector":"00/223","entry_index":1,"draft_translation":"알고 있어. / 아빠한테 가자!"},

    {"selector":"00/224","entry_index":0,"draft_translation":"아빠, 큰일이야! / 아지나가!"},
    {"selector":"00/224","entry_index":1,"draft_translation":"넷토, 네가 어떻게 / 그 일을 알고 있지?"},
    {"selector":"00/224","entry_index":2,"draft_translation":"아까 인터넷으로 / 메일 친구를 만나러 / 아지나 스퀘어에 갔었어."},
    {"selector":"00/224","entry_index":3,"draft_translation":"그럼 아지나를 멸망시킨 내비가 / 일본으로 오고 있다는 것도 / 알고 있겠구나."},
    {"selector":"00/224","entry_index":4,"draft_translation":"응. / 우리가 할 수 있는 일이 / 없을까?"},
    {"selector":"00/224","entry_index":5,"draft_translation":"지금 오피셜 넷배틀러들이 / 인터넷을 순찰하고 있으니 / 넷토는 아무것도 하지 않아도 돼."},
    {"selector":"00/224","entry_index":6,"draft_translation":"그래도 나도 뭔가 / 도움이 되고 싶어!"},
    {"selector":"00/224","entry_index":7,"draft_translation":"그렇구나... / 그럼 아빠가 지금 연구 중인 / 이론이 하나 있는데, // 그 이론을 완성하는 데 / 필요한 프로그램을 / 찾아다 주겠니?"},
    {"selector":"00/224","entry_index":8,"draft_translation":"그 프로그램은 어디 있어?"},
    {"selector":"00/224","entry_index":9,"draft_translation":"그걸 모르겠구나... / 인터넷에 있는 모양이지만 // 어느 영역에 있는지는 / 알 수가 없어."},
    {"selector":"00/224","entry_index":10,"draft_translation":"알았어, 아빠! / 그 프로그램을 찾아올게!"},
    {"selector":"00/224","entry_index":11,"draft_translation":"넷토, 이것만은 꼭 지켜 다오. / 어디선가 그 내비를 만나면 / 싸우지 말고 도망쳐야 한다."},
    {"selector":"00/224","entry_index":12,"draft_translation":"...하지만!"},
    {"selector":"00/224","entry_index":13,"draft_translation":"지금 록맨의 성능으로는 / 아마 이길 수 없을 거야."},
    {"selector":"00/224","entry_index":14,"draft_translation":"그래도 도망만 치는 건 싫어!"},
    {"selector":"00/224","entry_index":15,"draft_translation":"아까 말한 아빠가 연구 중인 / 프로그램은 // 록맨의 성능을 높여 주는 / 프로그램이야. // 그 프로그램을 완성해 / 록맨에게 설치하면 / 큰 전력이 될 거야. // 그 프로그램의 이름은 / 「[printItem item=21]」(체인지 배치)인데... // 사실 프로그램 이름 말고는 / 아는 게 없단다. // 오피셜 스퀘어의 / 전뇌 게시판에 정보를 구하는 / 글을 올리면 // 뭔가 정보를 / 얻을 수 있을지도 모르니 / 한번 가 보렴. // 사실은 아빠가 찾아야 하지만 / 지금은 자리를 비울 수 없구나."},
    {"selector":"00/224","entry_index":16,"draft_translation":"알고 있어, 아빠! / 우리에게 맡겨 줘!"},

    {"selector":"00/225","entry_index":0,"draft_translation":"정보를 구하는 글을 올리자! / 뭐라고 쓸까?"},
    {"selector":"00/225","entry_index":1,"draft_translation":"어디 보자... // 「[printItem item=21]」을 찾습니다. / 정보를 기다리겠습니다. / 록맨.EXE // 좋아, 이걸로 하자!"},
    {"selector":"00/225","entry_index":2,"draft_translation":"오케이, 올렸어! // 이제 정보가 들어오기를 / 기다리기만 하면 돼."},
    {"selector":"00/225","entry_index":3,"draft_translation":"얼마나 기다려야 해?"},
    {"selector":"00/225","entry_index":4,"draft_translation":"그렇게 금방 답장이 / 올 리 없잖아. / 성급하면 손해라고! // 오피셜 스퀘어에서 / 정보를 모으면서 시간을 보내자."},

    {"selector":"00/226","entry_index":0,"draft_translation":"좋아! 넷토 군, / 당장 아키하라 마을로 가 보자!"},

    {"selector":"00/228","entry_index":0,"draft_translation":"삐―삐―삐―삐―삐―! // 보안 시스템 작동!!"},
    {"selector":"00/228","entry_index":1,"draft_translation":"무슨 일이 일어난 거지!?"},
    {"selector":"00/228","entry_index":2,"draft_translation":"이 프로그램은 아지나의 / 국보였던 모양이야. // 그래서 보안 시스템이 / 작동한 거야!"},
    {"selector":"00/228","entry_index":3,"draft_translation":"그러니까 우리... / 도둑이 된 거야!?"},
    {"selector":"00/228","entry_index":4,"draft_translation":"빨리 탈출하자!"},
    {"selector":"00/228","entry_index":5,"draft_translation":"좋아, 플러그아웃하자!"},

    {"selector":"00/229","entry_index":0,"draft_translation":"국보를 내려놓고 물러가라!! / 물러가지 않는다면 // 바이러스를 풀어놓겠다!"},
    {"selector":"00/230","entry_index":0,"draft_translation":"국보에 손을 댄 / 어리석은 자여!! // 용서하지 않겠다! / 바이러스에게 좀먹혀라!"},
    {"selector":"00/231","entry_index":0,"draft_translation":"국보를 돌려놓아라, 도둑놈! // 모두, 덤벼라!"},
    {"selector":"00/232","entry_index":0,"draft_translation":"도둑이여, / 이곳이 네 무덤이다! // 바이러스의 심판을 / 받아라!"},
    {"selector":"00/233","entry_index":0,"draft_translation":"어떻게든 프로그램을 얻었네. / 그래도 뭔가 나쁜 짓을 / 저지른 것 같아."},

    {"selector":"00/234","entry_index":0,"draft_translation":"아빠, 프로그램 가져왔어!"},
    {"selector":"00/234","entry_index":1,"draft_translation":"오, 넷토. / 미안하구나."},
    {"selector":"00/234","entry_index":2,"draft_translation":"이 프로그램은 아지나 스퀘어에 / 있었는데, // 아무래도 밖으로 가져오면 / 안 되는 물건이었나 봐."},
    {"selector":"00/234","entry_index":3,"draft_translation":"그렇구나. 나중에 아빠가 / 아지나 스퀘어로 / 전송해 놓으마."},
    {"selector":"00/234","entry_index":4,"draft_translation":"그럼 바로 이 프로그램을 / 결합해서..."},
    {"selector":"00/234","entry_index":5,"draft_translation":"타다다다닥...[wait 84]"},
    {"selector":"00/234","entry_index":6,"draft_translation":"좋아, 됐다! / 새로운 프로그램이 / 완성됐어!! // 넷토, PET를 빌려주겠니?"},
    {"selector":"00/234","entry_index":7,"draft_translation":"응, 아빠."},
    {"selector":"00/234","entry_index":8,"draft_translation":"록맨, 조금 아플지도 모르지만 / 참아야 한다."},
    {"selector":"00/234","entry_index":9,"draft_translation":"네."},
    {"selector":"00/234","entry_index":10,"draft_translation":"새 프로그램 설치."},
    {"selector":"00/234","entry_index":11,"draft_translation":"타다다다닥...[wait 85]"},
    {"selector":"00/234","entry_index":12,"draft_translation":"으윽· 그그그그그그...!"},
    {"selector":"00/234","entry_index":13,"draft_translation":"타다다다닥...[wait 85]"},
    {"selector":"00/234","entry_index":14,"draft_translation":"조금만 더 힘내!"},
    {"selector":"00/234","entry_index":15,"draft_translation":"네... 네...!"},
    {"selector":"00/234","entry_index":16,"draft_translation":"타다다다닥...[wait 85]"},
    {"selector":"00/234","entry_index":17,"draft_translation":"설치 완료!"},
    {"selector":"00/234","entry_index":18,"draft_translation":"괜찮니!? / 록맨?"},
    {"selector":"00/234","entry_index":19,"draft_translation":"괜찮은 것 같긴 한데... / 설치하기 전과 / 별로 달라진 게 없는 것 같아..."},
    {"selector":"00/234","entry_index":20,"draft_translation":"방금 설치한 프로그램은 / 록맨을 강하게 만드는 / 씨앗 같은 거란다. // 록맨의 경험을 / 영양분 삼아 싹을 틔우지. // 언제 싹이 틀지는 모르지만 / 그 싹이 돋아날 때 // 록맨은 새로운 힘을 / 얻을 수 있을 거야!"},
    {"selector":"00/234","entry_index":21,"draft_translation":"고마워, 아빠!"},
    {"selector":"00/234","entry_index":22,"draft_translation":"삐―[wait 54] // 삐―[wait 54] // 삐―[wait 54] // !!"},
    {"selector":"00/234","entry_index":23,"draft_translation":"오피셜 스퀘어에 / 정체불명의 침입자가 나타난 모양이야!"},
    {"selector":"00/234","entry_index":24,"draft_translation":"설마 그 내비가...!!"},
    {"selector":"00/234","entry_index":25,"draft_translation":"가자! 넷토 군!"},
    {"selector":"00/234","entry_index":26,"draft_translation":"좋아!"},
    {"selector":"00/234","entry_index":27,"draft_translation":"넷토! / 절대로 무리하지 마라!"},

    {"selector":"00/235","entry_index":0,"draft_translation":"네가 아지나 스퀘어를 / 엉망으로 만든 내비냐!?"},
    {"selector":"00/235","entry_index":1,"draft_translation":"크크크... / 오피셜 녀석들도 / 하나같이 바보뿐이군... // 섀도맨 대장은 지금쯤 / 오피셜 센터의 / 마더 컴퓨터 안에 있을 거다."},
    {"selector":"00/235","entry_index":2,"draft_translation":"당했다! 유인 작전이었나!"},

    {"selector":"00/236","entry_index":0,"draft_translation":"넷토 군! / 아빠한테 가자!"}
  ]
}
