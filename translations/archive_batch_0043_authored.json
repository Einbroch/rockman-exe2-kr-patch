{
  "schema_version": 1,
  "batch_number": 43,
  "entries": [
    {"selector":"00/258","entry_index":18,"draft_translation":"꺄아아아아아―!"},

    {"selector":"00/259","entry_index":0,"draft_translation":"넷토 군![waitSkip 30] // 넷토 군!"},
    {"selector":"00/259","entry_index":1,"draft_translation":"으...[waitSkip 30] // 으음...[waitSkip 30] // ·[waitSkip 30]·[waitSkip 30]·"},
    {"selector":"00/259","entry_index":2,"draft_translation":"여기는...[waitSkip 30] // 어디지?"},
    {"selector":"00/259","entry_index":3,"draft_translation":"성의 지하실인 것 같아. / 우리 꽤 깊이 떨어졌나 봐... // 괜찮아? 움직일 수 있겠어?"},
    {"selector":"00/259","entry_index":4,"draft_translation":"응...[waitSkip 30] // 아얏![waitSkip 30] // 조금 긁힌 것 같지만... / 그래도 괜찮아!"},
    {"selector":"00/259","entry_index":5,"draft_translation":"삐삐삐삐삐![wait 60]"},
    {"selector":"00/259","entry_index":6,"draft_translation":"뭐지?"},
    {"selector":"00/259","entry_index":7,"draft_translation":"여러분...[waitSkip 30] // 무사하십니까? // 본부의 연락에 따르면 / 이번 회의는 이미 / 「고스펠」에게 들킨 모양입니다. // 「고스펠」은 넷배틀러를 보내 / 회의를 방해했습니다. // 안타깝게도 「궁극의 내비」 개발을 / 저지하기 위한 데이터도 / 도난당했습니다... // 게다가 그 넷배틀러는 / 성의 「침입자 격퇴 시스템」을 해킹해 // 성 안의 함정을 작동시켰습니다. // 그렇습니다. 그자는 / 여러분의 목숨을 노리고 있습니다!"},
    {"selector":"00/259","entry_index":8,"draft_translation":"휙!!![wait 10] // 푹!!"},
    {"selector":"00/259","entry_index":9,"draft_translation":"크아아아아아―!!!"},
    {"selector":"00/259","entry_index":10,"draft_translation":"뚜―[wait 57] // 뚜―[wait 57] // 뚜―[wait 58] // 삐삐!"},
    {"selector":"00/259","entry_index":11,"draft_translation":"다들 들었지?"},
    {"selector":"00/259","entry_index":12,"draft_translation":"응! 큰일이 벌어졌네. // 방금 그 사람도 분명..."},
    {"selector":"00/259","entry_index":13,"draft_translation":"어쨌든 고립되면 위험하다. / 무슨 일이 생기면 즉시 / 서로 연락하도록 하자! 알겠나?"},
    {"selector":"00/259","entry_index":14,"draft_translation":"좋습니다. 그러면 「고스펠」 / 넷배틀러의 위치도 / 빨리 알아낼 수 있을 겁니다."},
    {"selector":"00/259","entry_index":15,"draft_translation":"정말이지, 이런 어두컴컴한 곳에 / 언제까지고 있고 싶진 않아! // 얼른 탈출해서 / 내가 그 녀석을 찾아내 주지!"},
    {"selector":"00/259","entry_index":16,"draft_translation":"일본 소년들도 / 그렇게 하면 되겠지?"},
    {"selector":"00/259","entry_index":17,"draft_translation":"네..."},

    {"selector":"00/260","entry_index":0,"draft_translation":"앗! 넷토 군, 위험해!"},
    {"selector":"00/260","entry_index":1,"draft_translation":"으앗!!"},

    {"selector":"00/261","entry_index":0,"draft_translation":"삐삐삐![wait 60]"},
    {"selector":"00/261","entry_index":1,"draft_translation":"존슨...[waitSkip 30] // 이다."},
    {"selector":"00/261","entry_index":2,"draft_translation":"무슨 일이야!?"},
    {"selector":"00/261","entry_index":3,"draft_translation":"미안하다...[waitSkip 30] // 함정에 당했...[waitSkip 30] // 다!"},
    {"selector":"00/261","entry_index":4,"draft_translation":"존슨 씨! / 구하러 갈게요! 지금 어디예요!?"},
    {"selector":"00/261","entry_index":5,"draft_translation":"나는 이제...[waitSkip 30] // 틀렸어! / 나 따위는...[waitSkip 30] // 신경 쓰지 말고 / 먼저 나아...[waitSkip 30] // 가라."},
    {"selector":"00/261","entry_index":6,"draft_translation":"쿠우우우우우우우웅!"},
    {"selector":"00/261","entry_index":7,"draft_translation":"크아아아아아아―!!"},

    {"selector":"00/262","entry_index":0,"draft_translation":"여긴 뭐야! 위험해!"},
    {"selector":"00/262","entry_index":1,"draft_translation":"천장이 내려오고 있어!"},
    {"selector":"00/262","entry_index":2,"draft_translation":"꺄아아아―!!"},
    {"selector":"00/262","entry_index":3,"draft_translation":"프린세스 씨야!"},
    {"selector":"00/262","entry_index":4,"draft_translation":"이 함정! 아까 / 존슨 씨가 당한 것과 / 같은 함정인 것 같아요!!"},
    {"selector":"00/262","entry_index":5,"draft_translation":"저기 있는 문![waitSkip 30] // 옆 스위치에 플러그인하면 / 열 수 있지 않을까!?"},
    {"selector":"00/262","entry_index":6,"draft_translation":"그게...[waitSkip 30] // 제 나이트맨은 아까 / 함정을 해제하다가 / 다치고 말았습니다..."},
    {"selector":"00/262","entry_index":7,"draft_translation":"넷토 군! 난 괜찮아! / 어서 나를 보내 줘!!"},

    {"selector":"00/263","entry_index":0,"draft_translation":"삐삐삐![wait 60]"},
    {"selector":"00/263","entry_index":1,"draft_translation":"여보세요? 누구죠!?"},
    {"selector":"00/263","entry_index":2,"draft_translation":"꺄아아아―!!"},
    {"selector":"00/263","entry_index":3,"draft_translation":"프린세스 씨야!"},
    {"selector":"00/263","entry_index":4,"draft_translation":"하아, 하아... / 제법이군요! // 하지만 다쳤다고 해도 / 나이트맨은 그리 간단히 / 쓰러지지 않아요!"},
    {"selector":"00/263","entry_index":5,"draft_translation":"누구 없어! / 프린세스 가까이에 있는 사람!"},
    {"selector":"00/263","entry_index":6,"draft_translation":"프린세스 씨! / 아직 아까 그곳에 있어요!?"},
    {"selector":"00/263","entry_index":7,"draft_translation":"로열 레킹 볼!!"},
    {"selector":"00/263","entry_index":8,"draft_translation":"눈치채지 못한 것 같아... / 통신 스위치가 우연히 / 켜진 모양이야."},
    {"selector":"00/263","entry_index":9,"draft_translation":"...! // 로열 레킹 볼이 통하지 않아!? / 이게 「고스펠」 내비의 힘인가!? // 나이트맨, 위험해!"},
    {"selector":"00/263","entry_index":10,"draft_translation":"안 돼―――!!![wait 120]"},
    {"selector":"00/263","entry_index":11,"draft_translation":"...넷토 군. // 네트워크에서 나이트맨의 / 반응이 사라졌어..."},
    {"selector":"00/263","entry_index":12,"draft_translation":"젠장!![waitSkip 30] // 프린세스 씨가 위험해!"},
    {"selector":"00/263","entry_index":13,"draft_translation":"쿠우우우우우우우웅!!!!"},
    {"selector":"00/263","entry_index":14,"draft_translation":"꺄아아아아아―!!"},
    {"selector":"00/263","entry_index":15,"draft_translation":"콰아앙!!"},
    {"selector":"00/263","entry_index":16,"draft_translation":"... // 뚜―[wait 57] // 뚜―[wait 57] // 뚜―[wait 58]"},
    {"selector":"00/263","entry_index":17,"draft_translation":"록맨! 아까 그 방으로 돌아가자!"},
    {"selector":"00/263","entry_index":18,"draft_translation":"히카리, 소용없다![waitSkip 30] // 이미...[waitSkip 30] // 늦었어... // 남은 인원끼리 한시라도 빨리 / 「고스펠」의 넷배틀러를 / 찾아내야 한다. // 더는 / 희생자를 낼 수 없어!"},

    {"selector":"00/264","entry_index":0,"draft_translation":"이게 뭐야! / 뜨거워어엇!!"},
    {"selector":"00/264","entry_index":1,"draft_translation":"넷토 군!"},
    {"selector":"00/264","entry_index":2,"draft_translation":"괜찮아! / 불똥이 조금 튄 것뿐이야. // 하지만 이대로는... 위험해."},
    {"selector":"00/264","entry_index":3,"draft_translation":"탈출해야 해! / 안쪽 문에 스위치가 있어!"},
    {"selector":"00/264","entry_index":4,"draft_translation":"하지만 플러그인하려 해도 / 이래서는 가까이 갈 수가 없어!"},
    {"selector":"00/264","entry_index":5,"draft_translation":"으음..."},
    {"selector":"00/264","entry_index":6,"draft_translation":"젠장! / 이런 곳에서 죽으면 / 이제 모두와...[waitSkip 30] // 모두...[waitSkip 30] // ·[waitSkip 30]·[waitSkip 30]· // ? // 그래, 메일이야!"},
    {"selector":"00/264","entry_index":7,"draft_translation":"맞아! 메일이야!"},
    {"selector":"00/264","entry_index":8,"draft_translation":"응, 아메롭파에 오기 전에 / 메일이 준 「[printItem item=24]」! / 그걸 쓰자!"},
    {"selector":"00/264","entry_index":9,"draft_translation":"넷토는 배낭에서 꺼냈다!! / 「[printItem item=24]」"},
    {"selector":"00/264","entry_index":10,"draft_translation":"간다!"},
    {"selector":"00/264","entry_index":11,"draft_translation":"좋아! 잘됐어!"},

    {"selector":"00/265","entry_index":0,"draft_translation":"넷토 군, / 또 누군가 연락한 거야!?"},
    {"selector":"00/265","entry_index":1,"draft_translation":"응! 여보세요!"},
    {"selector":"00/265","entry_index":2,"draft_translation":"하아... 하아..."},
    {"selector":"00/265","entry_index":3,"draft_translation":"라울 씨!"},
    {"selector":"00/265","entry_index":4,"draft_translation":"넷토... 군인가... / 미안하다... 당해 버렸어... / 나머지는 부탁... 한다."},
    {"selector":"00/265","entry_index":5,"draft_translation":"뚜―[wait 57] // 뚜―[wait 57] // 뚜―[wait 58]"},
    {"selector":"00/265","entry_index":6,"draft_translation":"라울 씨까지..."},
    {"selector":"00/265","entry_index":7,"draft_translation":"넷토 군... 이상하지 않아?"},
    {"selector":"00/265","entry_index":8,"draft_translation":"응? 뭐가?"},
    {"selector":"00/265","entry_index":9,"draft_translation":"다들 당해 버렸잖아. // 남은 건 / 넷토 군과 엔잔 군뿐이야..."},
    {"selector":"00/265","entry_index":10,"draft_translation":"그렇다면 우리 사이에 숨어든 / 「고스펠」의 넷배틀러는... // 설마!? / 엔잔이 「고스펠」이라니 / 아무리 그래도 말이 안 돼!"},
    {"selector":"00/265","entry_index":11,"draft_translation":"나도 그렇게 믿고 싶지만..."},

    {"selector":"00/266","entry_index":0,"draft_translation":"라울 씨! 라울 씨!"},
    {"selector":"00/266","entry_index":1,"draft_translation":"하아... 하아..."},
    {"selector":"00/266","entry_index":2,"draft_translation":"아직 숨이 붙어 있어! 살릴 수 있어!"},
    {"selector":"00/266","entry_index":3,"draft_translation":"!!"},
    {"selector":"00/266","entry_index":4,"draft_translation":"히카리... 설마 했지만 / 「고스펠」의 넷배틀러는 / 역시 너였나..."},
    {"selector":"00/266","entry_index":5,"draft_translation":"엔잔, 무슨 소리야!?"},
    {"selector":"00/266","entry_index":6,"draft_translation":"흥... 시치미를 뗄 셈인가... // 하지만 이 상황이 / 움직일 수 없는 증거다..."},
    {"selector":"00/266","entry_index":7,"draft_translation":"아니야! 나도 방금 왔어![waitSkip 30] // ...그럼 너도 「고스펠」이 / 아니었던 거야? // 대체 누가 라울 씨를... / 모두를 해친 거지!?"},
    {"selector":"00/266","entry_index":8,"draft_translation":"영문 모를 소리를... // 어쨌든 오피셜 권한으로 / 널 체포하겠다. // 사정은 나중에 천천히 듣지. / 하지만 그 전에...[waitSkip 30] // 만악의 근원, 록맨.EXE.[waitSkip 30] // ...아니! // 「흉악 바이러스 / 록맨」을 딜리트하겠다! // 블루스! / 바이러스 버스팅이다!"},

    {"selector":"00/267","entry_index":0,"draft_translation":"·[waitSkip 30]·[waitSkip 30]·"},
    {"selector":"00/267","entry_index":1,"draft_translation":"엔잔, 미안해. / 내가 블루스를..."},
    {"selector":"00/267","entry_index":2,"draft_translation":"...약하군."},
    {"selector":"00/267","entry_index":3,"draft_translation":"?"},
    {"selector":"00/267","entry_index":4,"draft_translation":"내 나약함이 / 블루스를 딜리트하게 만들었다. // 내가 너를 100% / 증오할 수 있었다면..."},
    {"selector":"00/267","entry_index":5,"draft_translation":"엔잔..."},
    {"selector":"00/267","entry_index":6,"draft_translation":"악인에게 베푸는 / 인정 따위는 필요 없다!"},
    {"selector":"00/267","entry_index":7,"draft_translation":"엔잔! 그건 오해야!"},
    {"selector":"00/267","entry_index":8,"draft_translation":"으, 으으..."},
    {"selector":"00/267","entry_index":9,"draft_translation":"!!"},
    {"selector":"00/267","entry_index":10,"draft_translation":"넷토 군의 말이 맞... 다. / 「고스펠」은 너희 둘 중 / 누구도 아니야. // 진짜 범인은 그 녀석이다... // 그 녀석은 「고스펠」에게 / 당한 게 아니었어...[waitSkip 30] // 우린 속고 있었던 거야..."}
  ],
  "review_notes": [
    "00/263의 ロイヤルレッキングボール은 나이트맨 기술명으로 로열 레킹 볼을 잠정 사용했다.",
    "00/264의 item 24는 동적 아이템명 출력이므로 printItem 토큰을 유지하고 조사가 이름에 의존하지 않게 구성했다.",
    "00/267의 범인 지칭은 다음 장면의 정체 공개를 앞서 확정하지 않고 원문의 あいつ에 맞춰 그 녀석으로 유지했다."
  ]
}
