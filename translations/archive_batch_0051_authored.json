{
  "schema_version": 1,
  "batch_number": 51,
  "entries": [
    {"selector":"00/333","entry_index":12,"draft_translation":"알겠니? 잘 들어. // 지금부터 내 「마음 프로그램」을 / 너와 풀 싱크로시킬 거야. // 팔이 움직이지 않아도 / PET를 조작하지 못해도 괜찮아... // 넷토 군은 마음으로...[waitSkip 30] / 나를 오퍼레이션하는 거야!!"},
    {"selector":"00/333","entry_index":13,"draft_translation":"마음으로...[waitSkip 30] / 그런...[waitSkip 30] 나...[waitSkip 30] 할 수 있을까?"},
    {"selector":"00/333","entry_index":14,"draft_translation":"괜찮아! // 우리는 원래 한 사람이었잖아...[waitSkip 30] / 게다가...[waitSkip 30] // 언제나 누구보다 강한 유대로 / 이어져 있어!"},
    {"selector":"00/333","entry_index":15,"draft_translation":"강한 유대... // 알겠어...[waitSkip 30] / 나...[waitSkip 30] 해 볼게! // 둘이서 버그 융합체를...[waitSkip 30] / 「고스펠」을 쓰러뜨리자!"},
    {"selector":"00/333","entry_index":16,"draft_translation":"그래야지!!"},
    {"selector":"00/333","entry_index":17,"draft_translation":"록맨! 어때?[waitSkip 30] 들려?"},
    {"selector":"00/333","entry_index":18,"draft_translation":"물론이지!"},
    {"selector":"00/333","entry_index":19,"draft_translation":"OK! 그럼 간다![waitSkip 30] / 배틀 오퍼레이션! 세트!"},

    {"selector":"00/334","entry_index":0,"draft_translation":"넷토 군...[waitSkip 30] 넷토 군!"},
    {"selector":"00/334","entry_index":1,"draft_translation":"으...[waitSkip 30] 으으...[waitSkip 30] 응."},
    {"selector":"00/334","entry_index":2,"draft_translation":"넷토 군, 정신 차려!"},
    {"selector":"00/334","entry_index":3,"draft_translation":"록...[waitSkip 30] 맨."},
    {"selector":"00/334","entry_index":4,"draft_translation":"정신이 들어?"},
    {"selector":"00/334","entry_index":5,"draft_translation":"응..."},
    {"selector":"00/334","entry_index":6,"draft_translation":"우리...[waitSkip 30] ...[waitSkip 30] ...[waitSkip 30] 해낸 거야?"},
    {"selector":"00/334","entry_index":7,"draft_translation":"응! 고스펠을 쓰러뜨렸어! // 봐! 서버도 이제 / 완전히 멈췄어!"},
    {"selector":"00/334","entry_index":8,"draft_translation":"...[waitSkip 30] 정말이다!"},
    {"selector":"00/334","entry_index":9,"draft_translation":"영차..."},
    {"selector":"00/334","entry_index":10,"draft_translation":"이봐! 괜찮아? 대답해!"},
    {"selector":"00/334","entry_index":11,"draft_translation":"·[waitSkip 30]·[waitSkip 30]·"},
    {"selector":"00/334","entry_index":12,"draft_translation":"안 되겠어..."},
    {"selector":"00/334","entry_index":13,"draft_translation":"그 애는 우리보다 오랫동안 / 전자파를 맞았으니...[waitSkip 30] ·[waitSkip 30] · // 응?"},
    {"selector":"00/334","entry_index":14,"draft_translation":"왜 그래?"},
    {"selector":"00/334","entry_index":15,"draft_translation":"그 애 옆에 떨어진 / 책 같은 것...[waitSkip 30] 저게 뭘까?"},
    {"selector":"00/334","entry_index":16,"draft_translation":"주워 보자."},
    {"selector":"00/334","entry_index":17,"draft_translation":"그것은 오래된 일기장이었고 / 신문 기사 하나가 / 끼워져 있었다..."},
    {"selector":"00/334","entry_index":18,"draft_translation":"이 기사... 5년 전 비행기가 / 추락한 사건의 기사야. / 기억나?"},
    {"selector":"00/334","entry_index":19,"draft_translation":"응. 비행기가 버그에 감염돼 / 추락한 사건이었지. // 세계 최초의 대규모 / 넷 범죄라고 / 뉴스에도 많이 나왔잖아."},
    {"selector":"00/334","entry_index":20,"draft_translation":"그 애는 이 사건과 / 무슨 관계가 있었던 걸까..."},
    {"selector":"00/334","entry_index":21,"draft_translation":"응... 안을 읽어 보자."},
    {"selector":"00/334","entry_index":22,"draft_translation":"...그 일기에는 / 이런 내용이 적혀 있었다... // 그의 부모님이 / 그 비행기 사고로 세상을 떠난 일, // 그 뒤 친척에게 맡겨진 그가 / 여러 가지 힘든 일을 겪은 일, // 그때 부모님이 남긴 재산도 / 그를 결코 행복하게 / 해 주지 못한 일, // 결국 누구도 믿지 못하게 된 그는 / 자신만의 세계에 / 틀어박혀 버린 일, // 그리고 무엇보다...[waitSkip 30] / 하루하루가 너무나 / 외롭고 쓸쓸했다는 일...[waitSkip 30] ·[waitSkip 30] ·"},
    {"selector":"00/334","entry_index":23,"draft_translation":"넷토 군...[waitSkip 30] / 왠지 마음이 슬퍼지네..."},
    {"selector":"00/334","entry_index":24,"draft_translation":"그래..."},
    {"selector":"00/334","entry_index":25,"draft_translation":"그를 배신하지 않은 건 / 아마 이 컴퓨터뿐이었을 거야..."},
    {"selector":"00/334","entry_index":26,"draft_translation":"응... // 그리고 인터넷에서 어른인 척하며 / 자신을 따르는 사람들을 모아..."},
    {"selector":"00/334","entry_index":27,"draft_translation":"고스펠을 결성했어..."},
    {"selector":"00/334","entry_index":28,"draft_translation":"...자신을 괴롭힌 / 이 현실 세계에 / 복수하기 위해서..."},
    {"selector":"00/334","entry_index":29,"draft_translation":"으, 으으음..."},
    {"selector":"00/334","entry_index":30,"draft_translation":"이봐! 정신이 들어?"},
    {"selector":"00/334","entry_index":31,"draft_translation":"·[waitSkip 30]·[waitSkip 30]·[waitSkip 30]!!!!"},
    {"selector":"00/334","entry_index":32,"draft_translation":"내, 내가 졌어! / 네 마음대로 해!! // 어차피 나 따윈...[waitSkip 30] / 살아 있어 봐야 소용없어!"},
    {"selector":"00/334","entry_index":33,"draft_translation":"바보야![waitSkip 30] 정신 좀 차려! / 죽어도 되는 사람은 없어!"},
    {"selector":"00/334","entry_index":34,"draft_translation":"거짓말이야! 사실은 내가 밉잖아! / 죽어 버리라고 생각하잖아!"},
    {"selector":"00/334","entry_index":35,"draft_translation":"거짓말 아니야!![waitSkip 30] // 하지만 네가 저지른 일의 벌은 / 반드시 받아야 해!"},
    {"selector":"00/334","entry_index":36,"draft_translation":"거봐!"},
    {"selector":"00/334","entry_index":37,"draft_translation":"하지만 말이야...[waitSkip 30] ·[waitSkip 30] ·"},
    {"selector":"00/334","entry_index":38,"draft_translation":"뭔데!"},
    {"selector":"00/334","entry_index":39,"draft_translation":"죄값을 다 치르고 나면... // 내가 네 첫 번째 친구가 / 되어 줄게!!"},

    {"selector":"00/336","entry_index":0,"draft_translation":"이봐~ 넷토! 언제까지 걸리는 거야![waitSkip 30] / 빨리 와~~!"},
    {"selector":"00/336","entry_index":1,"draft_translation":"넷토 군, 서둘러야 해!"},
    {"selector":"00/336","entry_index":2,"draft_translation":"응. // ...미안, 미안! 지금 갈게!"},
    {"selector":"00/336","entry_index":3,"draft_translation":"오, 장작 가져왔구나! // 하지만... 늦었어! / 이 데카오 님의 명령은 / 척척 해내야지!"},
    {"selector":"00/336","entry_index":4,"draft_translation":"뭐야! 모처럼 가져왔더니!"},
    {"selector":"00/336","entry_index":5,"draft_translation":"...뭐,[waitSkip 30] 말은 그렇게 해도 / 이렇게 다시 캠핑할 수 있는 건 / 넷토 덕분이니까. // 고맙다! 넷토!!"},
    {"selector":"00/336","entry_index":6,"draft_translation":"뭐야, 갑자기...[waitSkip 30] // 그건 모두가 도와줘서 / 해낼 수 있었다고 했잖아."},
    {"selector":"00/336","entry_index":7,"draft_translation":"넷토~ 너란 녀석은~~~~[waitSkip 30] / 으허엉, 어어어어어어엉~~~"},
    {"selector":"00/336","entry_index":8,"draft_translation":"이봐, 또 그러냐...[waitSkip 30] 난감하네~"},
    {"selector":"00/336","entry_index":9,"draft_translation":"잠깐, 히카리 군! 여긴 아직이야![waitSkip 30] // 그 삼류 연극에 어울리지 말고 / 빨리 와 줘!"},
    {"selector":"00/336","entry_index":10,"draft_translation":"OK! 조금만 기다려!"},
    {"selector":"00/336","entry_index":11,"draft_translation":"피슈슈슈슈슈![wait 60]"},
    {"selector":"00/336","entry_index":12,"draft_translation":"호오~ 대단하구려, 말입죠! / 눈 깜짝할 사이에 / 물고기를 잡는구려, 말입죠!!"},
    {"selector":"00/336","entry_index":13,"draft_translation":"방법이라면 가르쳐 드릴게요. / 히구레 씨도 해 보실래요?"},
    {"selector":"00/336","entry_index":14,"draft_translation":"그렇구려~[waitSkip 30] / ...한번 해 보겠소, 말입죠!"},
    {"selector":"00/336","entry_index":15,"draft_translation":"피슈슈슈슈슈![wait 60]"},
    {"selector":"00/336","entry_index":16,"draft_translation":"그런데...[waitSkip 30] 어라,[waitSkip 30] 어라?[waitSkip 30] / 아야야야야야야야아아아아!!!"},
    {"selector":"00/336","entry_index":17,"draft_translation":"풍덩!"},
    {"selector":"00/336","entry_index":18,"draft_translation":"하하하하하![waitSkip 30] ...이럴 때가 아니지! / 빨리 야이토한테 가야 해! / 히구레 씨, 나중에 봐요!"},
    {"selector":"00/336","entry_index":19,"draft_translation":"말입죠오..."},
    {"selector":"00/336","entry_index":20,"draft_translation":"정말! 어디까지 갔다 온 거야...[waitSkip 30] // 그래도 많이 잡은 것 같으니 / 용서해 줄게. // 어때? 모처럼이니 / 이 야이토 님의 요리 솜씨를 / 보고 가도록 해! // 이래 봬도 꽤 가정적이거든.[waitSkip 30] / 나,[waitSkip 30] 는,[waitSkip 30] 말이지."},
    {"selector":"00/336","entry_index":21,"draft_translation":"아! 넷토![waitSkip 30] / 나 또 칼을 두고 왔나 봐!"},
    {"selector":"00/336","entry_index":22,"draft_translation":"뭐~! 진짜냐!"},
    {"selector":"00/336","entry_index":23,"draft_translation":"...넌 조그마니까 / 조심해서 물고기 구워!"},
    {"selector":"00/336","entry_index":24,"draft_translation":"뭐야! / 어린애 취급하지 마아아![waitSkip 30] / 너 따위... 메~롱이다!![wait 60]"},
    {"selector":"00/336","entry_index":25,"draft_translation":"왜 그러니, 넷토?[waitSkip 30] / 아,[waitSkip 10] 칼 말이지.[waitSkip 10] 그래, 그래."},
    {"selector":"00/336","entry_index":26,"draft_translation":"...그건 그렇고 / 아빠와 함께 캠핑이라니 / 정말 오랜만이네~"},
    {"selector":"00/336","entry_index":27,"draft_translation":"하하하, 계속 바빴으니까.[waitSkip 30] / 미안해, 엄마."},
    {"selector":"00/336","entry_index":28,"draft_translation":"아니야, 괜찮아. // 유이치로 씨가 / 힘든 일을 하고 있다는 걸 / 난 잘 알고 있으니까."},
    {"selector":"00/336","entry_index":29,"draft_translation":"고마워...[waitSkip 30] 하루카."},
    {"selector":"00/336","entry_index":30,"draft_translation":"아빠아!"},
    {"selector":"00/336","entry_index":31,"draft_translation":"아, 미안 미안. 물론 넷토도 말이야. / 당분간은 조금 한가하니까 / 함께 놀자!"},
    {"selector":"00/336","entry_index":32,"draft_translation":"신난다!!"},
    {"selector":"00/336","entry_index":33,"draft_translation":"넷토~! 아직 멀었어?"},
    {"selector":"00/336","entry_index":34,"draft_translation":"자, 빨리 가 봐야지. / 여자아이를 내버려 두면 안 돼."},
    {"selector":"00/336","entry_index":35,"draft_translation":"·[waitSkip 30]·[waitSkip 30]·"},
    {"selector":"00/336","entry_index":36,"draft_translation":"아, 방금 말은 유이치로 씨에게 / 빈정댄 게 아니니까."},
    {"selector":"00/336","entry_index":37,"draft_translation":"정말이야?"},
    {"selector":"00/336","entry_index":38,"draft_translation":"저...[waitSkip 30] 엉...[waitSkip 30] 말."},
    {"selector":"00/336","entry_index":39,"draft_translation":"엄마..."},
    {"selector":"00/336","entry_index":40,"draft_translation":"아빠..."},
    {"selector":"00/336","entry_index":41,"draft_translation":"어휴..."},
    {"selector":"00/336","entry_index":42,"draft_translation":"이쪽이 다 부끄러워지네..."},
    {"selector":"00/336","entry_index":43,"draft_translation":"가자!"},
    {"selector":"00/336","entry_index":44,"draft_translation":"훗... 늦었군."},
    {"selector":"00/336","entry_index":45,"draft_translation":"???"},
    {"selector":"00/336","entry_index":46,"draft_translation":"아, 넷토. / 칼이라면 엔잔 군에게 / 벌써 받았어. // 고마워, 엔잔 군."},
    {"selector":"00/336","entry_index":47,"draft_translation":"괜찮아... / 네 부탁이니까."},
    {"selector":"00/336","entry_index":48,"draft_translation":"뭐야, 메이루! / 대체 무슨 생각이야!!"},
    {"selector":"00/336","entry_index":49,"draft_translation":"넷토가 늦었기 때문이잖아! / 엔잔 군은 넷토와 달리 / 친절하다고!"},
    {"selector":"00/336","entry_index":50,"draft_translation":"...하지만 넷토가 가져온 / 칼도 소중하고...[waitSkip 30] / 어느 것부터 쓸까..."},
    {"selector":"00/336","entry_index":51,"draft_translation":"뭐냐고... 정말."}
  ],
  "review_notes": [
    "00/333의 ココロ・プログラム은 마음 프로그램으로 옮기고 넷토와 록맨의 풀 싱크로 장면에서 형제 관계와 오퍼레이션 용어를 유지했다.",
    "00/334는 고스펠 수령의 과거와 고립감을 설명하는 결말 장면이므로 비난을 덧붙이지 않고 원문의 서술 순서를 보존했다.",
    "00/336의 日暮 특유 어미 でマス는 기존 배치와 동일하게 말입죠 계열로 통일했다.",
    "00/336의 캠핑 후일담에서는 데카오·야이토·메이루·엔잔의 기존 표기와 가족 호칭을 유지했다."
  ]
}
