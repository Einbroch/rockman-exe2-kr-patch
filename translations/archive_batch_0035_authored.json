{
 "schema_version": 1,
 "batch_number": 35,
 "entries": [
  {
   "selector": "00/168",
   "entry_index": 2,
   "draft_translation": "좋습니다! 인터넷 어딘가에 / 「[printItem item=1]」와 「[printItem item=2]」를 / 설치했습니다! // 이 두 개를 찾아내면 / 이곳으로 돌아오세요. / 그러면 [printItem item=58]를 드리겠습니다!"
  },
  {
   "selector": "00/168",
   "entry_index": 3,
   "draft_translation": "가자, 록맨!"
  },
  {
   "selector": "00/169",
   "entry_index": 0,
   "draft_translation": "오! / 두 개를 가져오셨군요! / 대단합니다! // ...그럼 약속대로 / [printItem item=58]를 드리죠."
  },
  {
   "selector": "00/169",
   "entry_index": 1,
   "draft_translation": "록맨은 / 「[printItem item=58]」를 / 획득했다!!"
  },
  {
   "selector": "00/169",
   "entry_index": 2,
   "draft_translation": "그걸 가지고 있으면 / 라이선스 시험 안내가 / 오피셜 센터에서 올 겁니다. // 열심히 해서 이번에는 / 라이선스를 획득하세요! // ...그리고 지금 한정 선물로 / 이것도 드리겠습니다! // 설치, 그러니까 프로그램을 PET에 넣어 / 사용할 수 있게 만드는 일도 / 제게 맡겨 주세요..."
  },
  {
   "selector": "00/169",
   "entry_index": 3,
   "draft_translation": "PET에 / 「레귤러 칩 시스템」이 / 설치되었다!!"
  },
  {
   "selector": "00/170",
   "entry_index": 0,
   "draft_translation": "메일?"
  },
  {
   "selector": "00/170",
   "entry_index": 1,
   "draft_translation": "어디 보자, 자동 전화인가 봐...[waitSkip 30] // 누구지...[waitSkip 30] // 아, 야이토의 내비인 / 글라이드 씨다! // 무슨 일이에요? / 그렇게 당황해서..."
  },
  {
   "selector": "00/170",
   "entry_index": 2,
   "draft_translation": "크, 큰일입니다!! / 야이토 님이!"
  },
  {
   "selector": "00/170",
   "entry_index": 3,
   "draft_translation": "야이토가 어떻게 됐는데?"
  },
  {
   "selector": "00/170",
   "entry_index": 4,
   "draft_translation": "목욕하러 들어가신 뒤 / 나오지 않으십니다!"
  },
  {
   "selector": "00/170",
   "entry_index": 5,
   "draft_translation": "느긋하게 목욕하는 것뿐 아냐?"
  },
  {
   "selector": "00/170",
   "entry_index": 6,
   "draft_translation": "그럴 리 없습니다. / 야이토 님은 목욕할 때 / 금세 현기증을 느끼십니다. // 게다가 가스 온수기의 상태도 / 이상한 것 같아서... / 걱정됩니다!"
  },
  {
   "selector": "00/170",
   "entry_index": 7,
   "draft_translation": "버그인가요?[waitSkip 30] // 아니면..."
  },
  {
   "selector": "00/170",
   "entry_index": 8,
   "draft_translation": "자세한 건 아직 모르겠습니다. / 하지만 가스 온수기의 경보음이 / 울리고 있습니다! // 저는 돌아가서 / 가스 온수기의 프로그램을 / 조사해 보겠습니다. // 넷토 씨, 야이토 님을 / 구하러 와 주십시오!"
  },
  {
   "selector": "00/170",
   "entry_index": 9,
   "draft_translation": "넷토, 들었지!?"
  },
  {
   "selector": "00/170",
   "entry_index": 10,
   "draft_translation": "응! 야이토 말이지?"
  },
  {
   "selector": "00/170",
   "entry_index": 11,
   "draft_translation": "데카오에게도 연락했는데... / 알지?"
  },
  {
   "selector": "00/170",
   "entry_index": 12,
   "draft_translation": "알았어! / 지금 야이토네로 갈게!"
  },
  {
   "selector": "00/171",
   "entry_index": 0,
   "draft_translation": "이러쿵저러쿵할 시간이 없어![waitSkip 30] // 잘 들어, 너희들![waitSkip 30] // 지금부터 내가 집 안으로 돌입한다! // 너희는 여기서 대기해!"
  },
  {
   "selector": "00/171",
   "entry_index": 1,
   "draft_translation": "괜찮겠어? / 다 같이 가는 게 낫지 않아?"
  },
  {
   "selector": "00/171",
   "entry_index": 2,
   "draft_translation": "안 돼![waitSkip 30] // 안쪽 상황을 모르는데 / 다 함께 움직이는 건 / 오히려 위험해! // 안심해! 이 데카오 님이 / 반드시 5분 안에 돌아올 테니까!"
  },
  {
   "selector": "00/171",
   "entry_index": 3,
   "draft_translation": "쾅! 철컥![waitSkip 30] / ·[waitSkip 30] / ·[waitSkip 30] / ·[waitSkip 30] / ·[waitSkip 30] / ·[waitSkip 30] / ·[waitSkip 30] / ·[waitSkip 30] / ·"
  },
  {
   "selector": "00/171",
   "entry_index": 4,
   "draft_translation": "넷토..."
  },
  {
   "selector": "00/171",
   "entry_index": 5,
   "draft_translation": "![waitSkip 30] // 5분이 지나 버렸잖아![waitSkip 30]"
  },
  {
   "selector": "00/172",
   "entry_index": 0,
   "draft_translation": "쾅! 철컥!"
  },
  {
   "selector": "00/172",
   "entry_index": 1,
   "draft_translation": "어? 문이 잠겼어!"
  },
  {
   "selector": "00/172",
   "entry_index": 2,
   "draft_translation": "야이토―! 데카오―! / 대답해―!"
  },
  {
   "selector": "00/172",
   "entry_index": 3,
   "draft_translation": "잠깐! 넷토!? 이 냄새!"
  },
  {
   "selector": "00/172",
   "entry_index": 4,
   "draft_translation": "정말이다! 냄새나!"
  },
  {
   "selector": "00/172",
   "entry_index": 5,
   "draft_translation": "이거 가스야! / 큰일이야! 둘 다 분명 / 가스에 당했을 거야!"
  },
  {
   "selector": "00/172",
   "entry_index": 6,
   "draft_translation": "게다가 갇혀서 / 탈출할 수도 없다는 건가... / 수상한데..."
  },
  {
   "selector": "00/172",
   "entry_index": 7,
   "draft_translation": "가스를 마시면 / 넷토도 위험해. / 잠깐만..."
  },
  {
   "selector": "00/172",
   "entry_index": 8,
   "draft_translation": "타다다다닥[wait 30]"
  },
  {
   "selector": "00/172",
   "entry_index": 9,
   "draft_translation": "기다렸지! PET에 / 가스 감지 기능을 추가했어! / 이제 화면에 가스가 표시될 거야!"
  },
  {
   "selector": "00/172",
   "entry_index": 10,
   "draft_translation": "고마워!"
  },
  {
   "selector": "00/172",
   "entry_index": 11,
   "draft_translation": "응, 이러면 가스를 마시지 않고 / 움직일 수 있겠어! / 두 사람을 찾으러 가자!"
  },
  {
   "selector": "00/173",
   "entry_index": 0,
   "draft_translation": "뭐야, 이게!"
  },
  {
   "selector": "00/173",
   "entry_index": 1,
   "draft_translation": "가스가 자욱해!"
  },
  {
   "selector": "00/173",
   "entry_index": 2,
   "draft_translation": "야이토는 분명 저기에..."
  },
  {
   "selector": "00/173",
   "entry_index": 3,
   "draft_translation": "제길! 빨리 구해야 해!"
  },
  {
   "selector": "00/173",
   "entry_index": 4,
   "draft_translation": "아, 넷토! 저기!"
  },
  {
   "selector": "00/173",
   "entry_index": 5,
   "draft_translation": "데카오잖아![waitSkip 30] // ·[waitSkip 30] / ·[waitSkip 30] / ·[waitSkip 30] // 이 가스,[waitSkip 30] // 어떻게 해야 하지!"
  },
  {
   "selector": "00/173",
   "entry_index": 6,
   "draft_translation": "아까 글라이드 씨가 / 「가스 온수기가 이상하다」고 / 말했잖아!"
  },
  {
   "selector": "00/174",
   "entry_index": 0,
   "draft_translation": "록맨!?"
  },
  {
   "selector": "00/174",
   "entry_index": 1,
   "draft_translation": "응, 특별히 이상한 곳은 / 없는 것 같은데..."
  },
  {
   "selector": "00/174",
   "entry_index": 2,
   "draft_translation": "하지만 프로그램이 이상하다면 / 분명 뭔가 있을 거야..."
  },
  {
   "selector": "00/174",
   "entry_index": 3,
   "draft_translation": "알았어, 방심하지 않을게!"
  },
  {
   "selector": "00/175",
   "entry_index": 0,
   "draft_translation": "빨리 저쪽으로 가야 해요![waitSkip 30] // 계속 가면 환풍기 프로그램이 있으니 / 고칠게요![waitSkip 30] // 가스 괜찮나요??[waitSkip 30] // ·[waitSkip 30] / · // 갑니다―!!"
  },
  {
   "selector": "00/175",
   "entry_index": 1,
   "draft_translation": "와~~"
  },
  {
   "selector": "00/175",
   "entry_index": 2,
   "draft_translation": "이제 못 견디겠어―요![waitSkip 30] / ·[waitSkip 30] / ·[waitSkip 30] / · // 어라?"
  },
  {
   "selector": "00/176",
   "entry_index": 0,
   "draft_translation": "넷토! 해냈어!"
  },
  {
   "selector": "00/176",
   "entry_index": 1,
   "draft_translation": "고마워! 록맨!"
  },
  {
   "selector": "00/177",
   "entry_index": 0,
   "draft_translation": "환풍기! 움직여![wait 60]"
  },
  {
   "selector": "00/177",
   "entry_index": 1,
   "draft_translation": "·부[waitSkip 30] // ·[waitSkip 30] // ·[waitSkip 30] // 부우우우우웅!"
  },
  {
   "selector": "00/177",
   "entry_index": 2,
   "draft_translation": "넷토!"
  },
  {
   "selector": "00/177",
   "entry_index": 3,
   "draft_translation": "응! 해냈어![waitSkip 30] // 데카오 발밑의 환풍기가 / 움직이기 시작했어!"
  },
  {
   "selector": "00/177",
   "entry_index": 4,
   "draft_translation": "빨리 데카오를!"
  },
  {
   "selector": "00/177",
   "entry_index": 5,
   "draft_translation": "물론이지!"
  },
  {
   "selector": "00/177",
   "entry_index": 6,
   "draft_translation": "어이![waitSkip 30] // 데카오![waitSkip 30] // 정신 차려!"
  },
  {
   "selector": "00/177",
   "entry_index": 7,
   "draft_translation": "·[waitSkip 30] / ·[waitSkip 30] / ·[waitSkip 30] // 으음...[waitSkip 30] // 으...[waitSkip 30] // 으[waitSkip 30] // 콜록, 콜록!"
  },
  {
   "selector": "00/177",
   "entry_index": 8,
   "draft_translation": "데카오! 눈을 떠!"
  },
  {
   "selector": "00/177",
   "entry_index": 9,
   "draft_translation": "데카오 님―![waitSkip 30] // 이구려!!"
  },
  {
   "selector": "00/177",
   "entry_index": 10,
   "draft_translation": "·[waitSkip 30] / ·[waitSkip 30] / ·[waitSkip 30] // 거...[waitSkip 30] // 거츠맨인가...[waitSkip 30] // 으, 응...[waitSkip 30] // 윽...[waitSkip 30] // 후우―[waitSkip 30] // 아―, 괴로웠다―[waitSkip 30] / 그래도 이제... // 괜찮아..."
  },
  {
   "selector": "00/177",
   "entry_index": 11,
   "draft_translation": "미안하다...[waitSkip 30] // 넷토!"
  },
  {
   "selector": "00/177",
   "entry_index": 12,
   "draft_translation": "사과하지 않아도 돼!"
  },
  {
   "selector": "00/177",
   "entry_index": 13,
   "draft_translation": "그렇다고 공짜로 / 신세만 질 수는 없지.[waitSkip 30] // 어이! 거츠맨!"
  },
  {
   "selector": "00/177",
   "entry_index": 14,
   "draft_translation": "예이구려! 데카오 님!"
  },
  {
   "selector": "00/177",
   "entry_index": 15,
   "draft_translation": "현관문 잠금을 풀러 가자! / 넷토가 언제든 탈출할 수 있게 / 해 주는 거야! // 좋아! 플러그아웃!"
  },
  {
   "selector": "00/177",
   "entry_index": 16,
   "draft_translation": "거츠로 가겠구려!"
  },
  {
   "selector": "00/177",
   "entry_index": 17,
   "draft_translation": "여긴...[waitSkip 30] // 맡긴다!"
  },
  {
   "selector": "00/177",
   "entry_index": 18,
   "draft_translation": "데카오 녀석...[waitSkip 30] / ·[waitSkip 30] / ·"
  },
  {
   "selector": "00/177",
   "entry_index": 19,
   "draft_translation": "넷토! / 감상에 젖어 있을 때가 아니야! / 아직 야이토가 남았어!"
  },
  {
   "selector": "00/177",
   "entry_index": 20,
   "draft_translation": "응! 잊지 않았어!"
  },
  {
   "selector": "00/177",
   "entry_index": 21,
   "draft_translation": "그럼 난 / 남은 스위치를 찾아볼게!"
  },
  {
   "selector": "00/178",
   "entry_index": 0,
   "draft_translation": "어때? 욕실에 가까이 갈 수 있겠어?"
  },
  {
   "selector": "00/178",
   "entry_index": 1,
   "draft_translation": "잠깐만."
  },
  {
   "selector": "00/178",
   "entry_index": 2,
   "draft_translation": "안 돼...[waitSkip 30] // 가스가 사라지지 않았어."
  },
  {
   "selector": "00/178",
   "entry_index": 3,
   "draft_translation": "어? 하지만 환풍기 프로그램은 / 이제 보이지 않는데.[waitSkip 30] // ... // 방금 건 상관없는 / 프로그램이었던 걸까?"
  },
  {
   "selector": "00/178",
   "entry_index": 4,
   "draft_translation": "제길, 뭔가 부채질할 물건만 있으면 / 이런 가스쯤은..."
  },
  {
   "selector": "00/178",
   "entry_index": 5,
   "draft_translation": "넷토! 그거야!"
  },
  {
   "selector": "00/178",
   "entry_index": 6,
   "draft_translation": "?"
  },
  {
   "selector": "00/178",
   "entry_index": 7,
   "draft_translation": "오늘 아침에 / 야이토와 나눈 이야기! / 기억나!? // 당연하지! // 글쎄... // 이야기 안 했나...?"
  },
  {
   "selector": "00/178",
   "entry_index": 8,
   "draft_translation": "그래! 부채야!"
  },
  {
   "selector": "00/178",
   "entry_index": 9,
   "draft_translation": "어... 뭐였더라?"
  },
  {
   "selector": "00/178",
   "entry_index": 10,
   "draft_translation": "거 있잖아! 부채 말이야!"
  },
  {
   "selector": "00/178",
   "entry_index": 11,
   "draft_translation": "...그렇지! 그거야!"
  },
  {
   "selector": "00/178",
   "entry_index": 12,
   "draft_translation": "어디 보자, 오늘 아침에 / 야이토와 이야기했었나?"
  },
  {
   "selector": "00/178",
   "entry_index": 13,
   "draft_translation": "그래?[waitSkip 30] // 내가 들은 바로는 / 야이토가 요즘 부채를 / 모으고 있대!"
  },
  {
   "selector": "00/178",
   "entry_index": 14,
   "draft_translation": "부채인가! 쓸 만하겠어!"
  },
  {
   "selector": "00/178",
   "entry_index": 15,
   "draft_translation": "부채라면 / 분명 이 집 어딘가에 있을 거야!"
  },
  {
   "selector": "00/179",
   "entry_index": 0,
   "draft_translation": "좋아, 간다―!"
  },
  {
   "selector": "00/179",
   "entry_index": 1,
   "draft_translation": "힘내―!"
  },
  {
   "selector": "00/179",
   "entry_index": 2,
   "draft_translation": "넷토!"
  },
  {
   "selector": "00/179",
   "entry_index": 3,
   "draft_translation": "으랴아아아아![waitSkip 30] // 이거나 먹어라아아아!"
  },
  {
   "selector": "00/179",
   "entry_index": 4,
   "draft_translation": "됐다!!"
  },
  {
   "selector": "00/179",
   "entry_index": 5,
   "draft_translation": "좋았어! 한 번 더!"
  },
  {
   "selector": "00/179",
   "entry_index": 6,
   "draft_translation": "이얍이얍이얍이야아아아!"
  },
  {
   "selector": "00/179",
   "entry_index": 7,
   "draft_translation": "해냈다!"
  },
  {
   "selector": "00/179",
   "entry_index": 8,
   "draft_translation": "응, 야이토를 찾았어! / 넷토, 빨리 야이토를!"
  }
 ]
}
